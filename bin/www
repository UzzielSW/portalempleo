#!/usr/bin/env node

// Aplicación Express principal.
var app = require('../app');

// Logger de depuración (se habilita con la variable de entorno DEBUG).
var debug = require('debug')('portalempleo:server');

// Módulo HTTP nativo de Node.js (servidor).
var http = require('http');

// Obtiene el puerto desde el entorno y lo guarda en Express.

// Prioriza PORT del entorno;
var port = normalizePort(process.env.PORT || 'NO SE ENCONTRO PUERTO');
app.set('port', port);

// * Crea el servidor HTTP.
// Envuelve la app de Express en un servidor HTTP.
var server = http.createServer(app);

// Escucha en el puerto indicado, en todas las interfaces de red.

// Arranca el servidor y registra manejadores de eventos.
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// Mensaje informativo de arranque (salida por consola).
console.log('Servidor ejecutándose en el puerto', process.env.PORT);

// Normaliza un puerto a número, string o false.
function normalizePort(val) {
  // Intenta convertir a número (p. ej. "3000" -> 3000).
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

// Listener del evento "error" del servidor HTTP.
function onError(error) {
  // Si no es un error relacionado con listen(), lo propagamos.
  if (error.syscall !== 'listen') {
    throw error;
  }

  // Identificador legible del destino (tubería o puerto).
  var bind = typeof port === 'string'
    ? 'Tubería ' + port
    : 'Puerto ' + port;

  // Maneja errores concretos de listen() con mensajes claros.
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requiere privilegios elevados');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' ya está en uso');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

// Listener del evento "listening" del servidor HTTP.
function onListening() {
  // Obtiene la dirección real donde está escuchando el servidor.
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'tubería ' + addr
    : 'puerto ' + addr.port;
  debug('Escuchando en ' + bind);
}
