doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Contactenos - Portal de Empleo UP
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel='stylesheet', href='/css/style.css')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")

    style.
      :root {
        --up-blue: #003876;
        --up-blue-dark: #002147;
        --up-blue-mid: #004a9f;
        --up-gold: #C49A1A;
        --up-gold-light: #e8c44d;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'DM Sans', sans-serif;
        background: #f0f4f8;
        color: #1a2233;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      h1, h2, h3, h4, .display { font-family: 'Sora', sans-serif; }

      /* ---- NAV ---- */
      .nav-portal {
        position: sticky; top: 0; z-index: 100;
        background: rgba(255,255,255,0.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid #e2e8f0;
      }

      .nav-inner {
        max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
        height: 72px; position: relative;
      }

      .nav-logo {
        display: flex; align-items: center; gap: 10px; text-decoration: none;
      }

      .nav-logo-icon {
        background: var(--up-blue); color: var(--up-gold);
        border-radius: 10px; width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      }

      .nav-logo-title {
        font-family: 'Sora', sans-serif; font-weight: 800;
        font-size: 1.05rem; color: var(--up-blue); line-height: 1.1;
      }

      .nav-logo-sub {
        font-size: 0.6rem; font-weight: 700; letter-spacing: 0.18em;
        text-transform: uppercase; color: var(--up-gold);
      }

      .nav-links {
        display: flex; align-items: center; gap: 2rem;
      }

      .nav-link {
        font-size: 0.8rem; font-weight: 600; color: #334155;
        text-decoration: none; letter-spacing: 0.04em; transition: color 0.2s;
      }

      .nav-link:hover { color: var(--up-gold); }
      .nav-link-active { color: var(--up-blue); border-bottom: 2px solid var(--up-gold); padding-bottom: 2px; }

      .btn-nav-login {
        background: var(--up-blue); color: #fff;
        font-family: 'Sora', sans-serif; font-size: 0.82rem; font-weight: 700;
        padding: 0.5rem 1.3rem; border-radius: 50px; text-decoration: none;
        transition: background 0.2s; box-shadow: 0 2px 10px rgba(0,56,118,0.2);
      }

      .btn-nav-login:hover { background: var(--up-gold); }

      .mobile-menu-btn {
        display: none; background: none; border: none;
        cursor: pointer; color: var(--up-blue);
      }

      /* ---- PAGE HEADER ---- */
      .page-header {
        background: linear-gradient(135deg, var(--up-blue) 0%, var(--up-blue-dark) 60%, #001530 100%);
        padding: 4rem 1.5rem 3.5rem;
        position: relative; overflow: hidden; text-align: center;
      }

      .page-header::before {
        content: ''; position: absolute;
        top: -80px; right: -60px; width: 280px; height: 280px;
        border-radius: 50%; background: rgba(255,255,255,0.04);
        pointer-events: none;
      }

      .page-header::after {
        content: ''; position: absolute;
        bottom: -70px; left: 8%; width: 240px; height: 240px;
        border-radius: 50%; background: rgba(196,154,26,0.07);
        pointer-events: none;
      }

      .page-header-inner { position: relative; z-index: 1; }

      .page-header-badge {
        display: inline-flex; align-items: center; gap: 7px;
        background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18);
        color: var(--up-gold-light); font-size: 0.68rem; font-weight: 700;
        letter-spacing: 0.18em; text-transform: uppercase;
        padding: 5px 14px; border-radius: 50px; margin-bottom: 1.2rem;
      }

      .page-header-badge-dot {
        width: 6px; height: 6px; border-radius: 50%; background: var(--up-gold-light);
      }

      .page-header-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800; color: #fff; margin-bottom: 0.8rem; line-height: 1.1;
      }

      .page-header-desc {
        font-size: 1rem; color: rgba(255,255,255,0.65);
        max-width: 560px; margin: 0 auto; line-height: 1.75;
      }

      /* ---- MAIN ---- */
      main { flex: 1; padding: 3rem 1.5rem 5rem; }

      .content-wrap {
        max-width: 960px; margin: 0 auto;
        display: flex; flex-direction: column; gap: 2rem;
      }

      /* ---- CONTACT CARDS GRID ---- */
      .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.2rem;
      }

      .contact-card {
        background: #fff; border-radius: 18px;
        border: 1.5px solid #e8edf5;
        padding: 2rem 1.5rem;
        display: flex; flex-direction: column; align-items: center;
        text-align: center; gap: 0.8rem;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
      }

      .contact-card:hover {
        border-color: rgba(0,56,118,0.25);
        box-shadow: 0 8px 28px rgba(0,56,118,0.08);
        transform: translateY(-2px);
      }

      .contact-card-icon {
        width: 58px; height: 58px; border-radius: 16px;
        background: linear-gradient(135deg, var(--up-blue), var(--up-blue-mid));
        display: flex; align-items: center; justify-content: center;
        color: var(--up-gold-light);
        box-shadow: 0 4px 14px rgba(0,56,118,0.2);
        margin-bottom: 0.3rem;
      }

      .contact-card-icon .material-symbols-outlined {
        font-size: 1.5rem; font-variation-settings: 'FILL' 1;
      }

      .contact-card-title {
        font-family: 'Sora', sans-serif; font-size: 1rem;
        font-weight: 800; color: #0f172a;
      }

      .contact-card-value {
        font-size: 0.92rem; font-weight: 600; color: var(--up-blue);
      }

      .contact-card-sub {
        font-size: 0.78rem; color: #94a3b8; line-height: 1.5;
      }

      .contact-card-link {
        display: inline-flex; align-items: center; gap: 5px;
        margin-top: 0.3rem; font-size: 0.82rem; font-weight: 700;
        color: var(--up-blue); text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: color 0.2s, border-color 0.2s;
      }

      .contact-card-link:hover { color: var(--up-gold); border-color: var(--up-gold); }

      /* ---- LOCATION CARD ---- */
      .location-card {
        background: #fff; border-radius: 20px;
        border: 1.5px solid #e8edf5;
        overflow: hidden;
        display: grid; grid-template-columns: 1fr 1.6fr;
      }

      .location-info {
        padding: 2.5rem;
        display: flex; flex-direction: column; gap: 1.2rem;
        justify-content: center;
      }

      .location-icon-wrap {
        width: 50px; height: 50px; border-radius: 14px;
        background: linear-gradient(135deg, var(--up-blue), var(--up-blue-mid));
        display: flex; align-items: center; justify-content: center;
        color: var(--up-gold-light);
        box-shadow: 0 4px 14px rgba(0,56,118,0.2);
      }

      .location-icon-wrap .material-symbols-outlined {
        font-size: 1.4rem; font-variation-settings: 'FILL' 1;
      }

      .location-title {
        font-family: 'Sora', sans-serif; font-size: 1.3rem;
        font-weight: 800; color: #0f172a;
      }

      .location-address {
        font-size: 0.9rem; color: #475569; line-height: 1.75;
      }

      .location-address strong {
        display: block; font-weight: 700; color: #0f172a; margin-bottom: 2px;
      }

      .location-detail-row {
        display: flex; flex-direction: column; gap: 8px;
      }

      .location-detail {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.82rem; color: #64748b;
      }

      .location-detail .material-symbols-outlined {
        font-size: 1rem; color: var(--up-blue);
        font-variation-settings: 'FILL' 1;
      }

      .btn-directions {
        display: inline-flex; align-items: center; gap: 7px;
        background: var(--up-blue); color: #fff;
        font-family: 'Sora', sans-serif; font-size: 0.85rem; font-weight: 700;
        padding: 0.65rem 1.3rem; border-radius: 10px; text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        width: fit-content;
        box-shadow: 0 4px 14px rgba(0,56,118,0.2);
      }

      .btn-directions:hover { background: var(--up-gold); transform: translateY(-1px); }

      .location-map {
        position: relative; overflow: hidden;
        min-height: 320px; background: #e8edf5;
      }

      .location-map iframe {
        width: 100%; height: 100%; border: none; display: block;
      }

      .map-overlay-btn {
        position: absolute; bottom: 14px; right: 14px;
        display: inline-flex; align-items: center; gap: 6px;
        background: #fff; color: #0f172a;
        font-family: 'Sora', sans-serif; font-size: 0.75rem; font-weight: 700;
        padding: 0.5rem 1rem; border-radius: 8px; text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
        border: 1px solid #e2e8f0;
        transition: box-shadow 0.2s;
      }

      .map-overlay-btn:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.16); }

      /* ---- CONTACT FORM ---- */
      .form-card {
        background: #fff; border-radius: 20px;
        border: 1.5px solid #e8edf5; padding: 2.5rem;
      }

      .form-card-header {
        display: flex; align-items: center; gap: 14px; margin-bottom: 2rem;
        padding-bottom: 1.5rem; border-bottom: 1px solid #f1f5f9;
      }

      .form-card-icon {
        width: 46px; height: 46px; border-radius: 12px;
        background: linear-gradient(135deg, var(--up-blue), var(--up-blue-mid));
        display: flex; align-items: center; justify-content: center;
        color: var(--up-gold-light); flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(0,56,118,0.2);
      }

      .form-card-icon .material-symbols-outlined { font-size: 1.3rem; font-variation-settings: 'FILL' 1; }

      .form-card-title {
        font-family: 'Sora', sans-serif; font-size: 1.2rem; font-weight: 800; color: #0f172a;
      }

      .form-card-subtitle { font-size: 0.82rem; color: #64748b; margin-top: 2px; }

      .form-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1.2rem;
      }

      .field-wrap { display: flex; flex-direction: column; gap: 5px; }
      .field-wrap.full { grid-column: 1 / -1; }

      .field-label {
        font-size: 0.82rem; font-weight: 600; color: #374151;
      }

      .field-input-wrap { position: relative; display: flex; align-items: center; }

      .field-icon {
        position: absolute; left: 13px;
        color: #94a3b8; font-size: 1rem;
        font-variation-settings: 'FILL' 0;
        pointer-events: none;
      }

      .field-input {
        width: 100%; height: 46px; padding: 0 14px 0 40px;
        border-radius: 10px; border: 1.5px solid #e2e8f0;
        background: #f8fafc; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; color: #1a2233; outline: none;
        transition: border-color 0.18s, box-shadow 0.18s;
      }

      .field-input:focus {
        border-color: var(--up-blue); background: #fff;
        box-shadow: 0 0 0 3px rgba(0,56,118,0.08);
      }

      .field-input::placeholder { color: #b0bec5; }

      .field-select {
        width: 100%; height: 46px; padding: 0 14px 0 40px;
        border-radius: 10px; border: 1.5px solid #e2e8f0;
        background: #f8fafc; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; color: #1a2233; outline: none; cursor: pointer;
        transition: border-color 0.18s, box-shadow 0.18s;
        appearance: none;
      }

      .field-select:focus {
        border-color: var(--up-blue); background: #fff;
        box-shadow: 0 0 0 3px rgba(0,56,118,0.08);
      }

      .field-textarea {
        width: 100%; padding: 12px 14px 12px 40px;
        border-radius: 10px; border: 1.5px solid #e2e8f0;
        background: #f8fafc; font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem; color: #1a2233; outline: none;
        resize: vertical; min-height: 120px; line-height: 1.6;
        transition: border-color 0.18s, box-shadow 0.18s;
      }

      .field-textarea:focus {
        border-color: var(--up-blue); background: #fff;
        box-shadow: 0 0 0 3px rgba(0,56,118,0.08);
      }

      .field-textarea::placeholder { color: #b0bec5; }

      .btn-submit {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        background: var(--up-blue); color: #fff; border: none;
        font-family: 'Sora', sans-serif; font-size: 0.92rem; font-weight: 700;
        padding: 0.8rem 2.2rem; border-radius: 12px; cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 4px 16px rgba(0,56,118,0.2);
      }

      .btn-submit:hover { background: var(--up-gold); transform: translateY(-1px); }

      /* ---- FOOTER STRIP ---- */
      .footer-strip {
        background: #fff; border-top: 1px solid #e8edf5;
        padding: 1.1rem 1.5rem;
        display: flex; flex-wrap: wrap; align-items: center;
        justify-content: space-between; gap: 0.5rem;
      }

      .footer-strip-left { font-size: 0.72rem; color: #94a3b8; }

      .footer-strip-links {
        display: flex; gap: 1.5rem;
      }

      .footer-strip-link {
        font-size: 0.72rem; color: #94a3b8; text-decoration: none;
        transition: color 0.2s;
      }

      .footer-strip-link:hover { color: var(--up-blue); }

      /* ---- RESPONSIVE ---- */
      @media (max-width: 900px) {
        .contact-grid { grid-template-columns: 1fr 1fr; }
        .location-card { grid-template-columns: 1fr; }
        .location-map { min-height: 260px; }
        .form-grid { grid-template-columns: 1fr; }
        .field-wrap.full { grid-column: 1; }
      }

      @media (max-width: 600px) {
        .contact-grid { grid-template-columns: 1fr; }
        .mobile-menu-btn { display: flex !important; }
        .nav-links { display: none; }
        .nav-links.open {
          display: flex; flex-direction: column;
          position: absolute; top: 72px; left: 0; right: 0;
          background: #fff; border-bottom: 1px solid #e2e8f0;
          padding: 1rem 1.5rem; gap: 0.8rem;
          box-shadow: 0 8px 20px rgba(0,0,0,0.08); z-index: 99;
        }
        .form-card { padding: 1.5rem; }
        .location-info { padding: 1.5rem; }
        .footer-strip { flex-direction: column; text-align: center; }
      }

  //- ============================================================
  //- NAVBAR
  //- ============================================================
  nav.nav-portal
    .nav-inner
      a.nav-logo(href='/')
        .nav-logo-icon
          span.material-symbols-outlined(style='font-size:1.5rem') school
        div
          .nav-logo-title Portal de Empleo UP
          .nav-logo-sub Universidad de Panama

      .nav-links
        a.nav-link(href='/') INICIO
        a.nav-link(href='/requirements') REQUISITOS PARA REGISTRARSE
        a.nav-link.nav-link-active(href='/contact') CONTACTENOS
        span(style='width:1px; height:24px; background:#e2e8f0; display:block')
        a.btn-nav-login(href='/login') Iniciar Sesion

      button.mobile-menu-btn(onclick='toggleMenu()' aria-label='Menu' style='display:none')
        span.material-symbols-outlined(style='font-size:1.6rem') menu

  //- ============================================================
  //- PAGE HEADER
  //- ============================================================
  .page-header
    .page-header-inner
      .page-header-badge
        .page-header-badge-dot
        | Direccion de Vinculacion con la Empresa &mdash; UP

      h1.page-header-title Contactenos

      p.page-header-desc
        | &iquest;Tiene preguntas sobre el Portal de Empleo UP? Nuestro equipo esta disponible para asistir a estudiantes, egresados y empresas interesadas en vincularse con la Universidad de Panama.

  //- ============================================================
  //- MAIN
  //- ============================================================
  main
    .content-wrap

      //- ---- CONTACT CARDS ----
      .contact-grid

        .contact-card
          .contact-card-icon
            span.material-symbols-outlined mail
          .contact-card-title Correo Electronico
          .contact-card-value vinculacion@up.ac.pa
          p.contact-card-sub Para consultas sobre registro, convenios y soporte general del portal.
          a.contact-card-link(href='mailto:vinculacion@up.ac.pa')
            | Enviar correo
            span.material-symbols-outlined(style='font-size:0.9rem') arrow_forward

        .contact-card
          .contact-card-icon
            span.material-symbols-outlined call
          .contact-card-title Telefono
          .contact-card-value (507) 523-5000
          p.contact-card-sub Ext. 2340 &mdash; Lunes a Viernes
          p.contact-card-sub 8:00 AM &ndash; 4:00 PM (hora de Panama)

        .contact-card
          .contact-card-icon
            span.material-symbols-outlined schedule
          .contact-card-title Horario de Atencion
          .contact-card-value Lun &ndash; Vie
          p.contact-card-sub 8:00 AM &ndash; 4:00 PM
          p.contact-card-sub Sede Central, Ciudad Universitaria

      //- ---- LOCATION ----
      .location-card

        .location-info
          .location-icon-wrap
            span.material-symbols-outlined location_on

          h3.location-title Visita nuestra oficina

          .location-address
            strong Direccion de Vinculacion con la Empresa y Seguimiento al Egresado
            | Ciudad Universitaria &ldquo;Octavio Mendez Pereira&rdquo;
            br
            | Edificio Administrativo, Planta Baja
            br
            | Panama, Republica de Panama

          .location-detail-row
            .location-detail
              span.material-symbols-outlined directions_bus
              | Transporte publico: Rutas hacia la Via Simon Bolivar
            .location-detail
              span.material-symbols-outlined local_parking
              | Estacionamiento disponible para visitantes
            .location-detail
              span.material-symbols-outlined subway
              | Metro: Estacion Ciudad Universitaria (Linea 1)

          a.btn-directions(href='https://maps.google.com/?q=Universidad+de+Panama+Ciudad+Universitaria' target='_blank' rel='noopener')
            span.material-symbols-outlined(style='font-size:1rem') directions
            | Como llegar

        .location-map
          iframe(
            src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3940.5!2d-79.5339!3d8.9936!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8faca8d8d8d8d8d8%3A0x0!2sUniversidad+de+Panam%C3%A1!5e0!3m2!1ses!2spa!4v1234567890'
            title='Ubicacion Universidad de Panama'
            allowfullscreen
            loading='lazy'
            referrerpolicy='no-referrer-when-downgrade'
          )
          a.map-overlay-btn(
            href='https://maps.google.com/?q=Universidad+de+Panama+Ciudad+Universitaria'
            target='_blank'
            rel='noopener'
          )
            span.material-symbols-outlined(style='font-size:0.9rem') open_in_new
            | Abrir en Google Maps

      //- ---- CONTACT FORM ----
      .form-card

        .form-card-header
          .form-card-icon
            span.material-symbols-outlined forum
          div
            .form-card-title Envienos un mensaje
            .form-card-subtitle Le responderemos en un plazo de 1 a 2 dias habiles

        form(action='/contacto/enviar' method='POST')
          .form-grid

            .field-wrap
              label.field-label(for='nombre') Nombre completo
              .field-input-wrap
                span.field-icon.material-symbols-outlined person
                input#nombre.field-input(
                  type='text' name='nombre'
                  placeholder='Ej. Maria Rodriguez'
                  required
                )

            .field-wrap
              label.field-label(for='email') Correo electronico
              .field-input-wrap
                span.field-icon.material-symbols-outlined mail
                input#email.field-input(
                  type='email' name='email'
                  placeholder='usuario@up.ac.pa'
                  required
                )

            .field-wrap
              label.field-label(for='tipo') Tipo de usuario
              .field-input-wrap
                span.field-icon.material-symbols-outlined badge
                select#tipo.field-select(name='tipo' required)
                  option(value='') Seleccione una opcion
                  option(value='estudiante') Estudiante UP
                  option(value='egresado') Egresado UP
                  option(value='empresa') Empresa / Entidad
                  option(value='otro') Otro

            .field-wrap
              label.field-label(for='asunto') Asunto
              .field-input-wrap
                span.field-icon.material-symbols-outlined subject
                input#asunto.field-input(
                  type='text' name='asunto'
                  placeholder='Ej. Consulta sobre convenio'
                  required
                )

            .field-wrap.full
              label.field-label(for='mensaje') Mensaje
              .field-input-wrap(style='align-items:flex-start')
                span.field-icon.material-symbols-outlined(style='top:12px; position:absolute') chat_bubble
                textarea#mensaje.field-textarea(
                  name='mensaje'
                  placeholder='Escriba aqui su consulta o comentario...'
                  required
                )

          div(style='display:flex; justify-content:flex-end; margin-top:0.5rem')
            button.btn-submit(type='submit')
              span.material-symbols-outlined(style='font-size:1.05rem; font-variation-settings:"FILL" 1') send
              | Enviar Mensaje

  //- ============================================================
  //- FOOTER
  //- ============================================================

  footer.footer-strip
    span.footer-strip-left &copy; #{new Date().getFullYear()} Universidad de Panamá &mdash; Desarrollado por &nbsp;
      strong Dirección de Tecnología de la Información y Comunicación.
    //- ============================================================
  //- SCRIPTS
  //- ============================================================
  script.
    function toggleMenu() {
      var nav = document.querySelector('.nav-links');
      nav.classList.toggle('open');
    }

    function applyResponsive() {
      var w = window.innerWidth;
      var mobileBtn = document.querySelector('.mobile-menu-btn');
      if (mobileBtn) mobileBtn.style.display = w < 600 ? 'flex' : 'none';

      var contactGrid = document.querySelector('.contact-grid');
      if (contactGrid) {
        if (w < 600) contactGrid.style.gridTemplateColumns = '1fr';
        else if (w < 900) contactGrid.style.gridTemplateColumns = '1fr 1fr';
        else contactGrid.style.gridTemplateColumns = 'repeat(3, 1fr)';
      }

      var locationCard = document.querySelector('.location-card');
      if (locationCard) {
        locationCard.style.gridTemplateColumns = w < 900 ? '1fr' : '1fr 1.6fr';
      }

      var formGrid = document.querySelector('.form-grid');
      if (formGrid) {
        formGrid.style.gridTemplateColumns = w < 900 ? '1fr' : '1fr 1fr';
      }
    }

    applyResponsive();
    window.addEventListener('resize', applyResponsive);
