  script.
    function toggleBookmark(btn) {
      var icon = btn.querySelector('.material-symbols-outlined');
      if(btn.classList.contains('saved')) {
        btn.classList.remove('saved');
        icon.style.fontVariationSettings = '"FILL" 0';
      } else {
        btn.classList.add('saved');
        icon.style.fontVariationSettings = '"FILL" 1';
      }
    }

    function shareJob() {
      if(navigator.share) {
        navigator.share({ title: 'Analista de Sistemas Senior - Rootstack', url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href).then(function(){
          alert('Enlace copiado al portapapeles.');
        });
      }
    }

    function postularAhora() {
      var m = document.getElementById('modal-apply');
      m.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      var m = document.getElementById('modal-apply');
      m.style.display = 'none';
      document.body.style.overflow = '';
    }

    function confirmApply() {
      closeModal();
      var btn = document.querySelector('.btn-apply');
      btn.style.background = '#22c55e';
      btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:1.1rem;font-variation-settings:\'FILL\' 1">check_circle</span> Postulacion Enviada';
      btn.disabled = true;
    }

    document.getElementById('modal-apply').addEventListener('click', function(e) {
      if(e.target === this) closeModal();
    });

    function applyR() {
      var w = window.innerWidth;
      var g = document.querySelector('.detail-grid');
      if(!g) return;
      g.style.gridTemplateColumns = w < 1024 ? '1fr' : '1fr 340px';
    }
    applyR();
    window.addEventListener('resize', applyR);
