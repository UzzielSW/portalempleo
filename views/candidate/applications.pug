    function openDrawer(key) {
      var d = drawerData[key];
      if(!d) return;
      document.getElementById('drawer-title').textContent = d.title;
      document.getElementById('drawer-sub').innerHTML = d.sub;

      var pipelineHtml = '<div class="ds-title" style="margin-bottom:0.8rem">Estado del Proceso</div><div class="pipeline">';
      d.pipeline.forEach(function(step) {
        var circleClass = step.state === 'done' ? 'ps-done' : step.state === 'current' ? 'ps-current' : 'ps-pending';
        pipelineHtml += '<div class="pipeline-step">';
        pipelineHtml += '<div class="ps-circle ' + circleClass + '"><span class="material-symbols-outlined">' + step.icon + '</span></div>';
        pipelineHtml += '<div style="padding-top:3px">';
        pipelineHtml += '<div class="ps-title">' + step.label + '</div>';
        pipelineHtml += '<div class="ps-date">' + step.date + '</div>';
        if(step.note) pipelineHtml += '<div class="ps-note">' + step.note + '</div>';
        pipelineHtml += '</div></div>';
      });
      pipelineHtml += '</div>';

      var detailHtml = '<div class="ds-title">Detalles de la Vacante</div><div class="ds-card">';
      detailHtml += '<div class="ds-row"><div class="ds-icon"><span class="material-symbols-outlined">business</span></div><div><div class="ds-label">Empresa</div><div class="ds-value">' + d.company + '</div></div></div>';
      detailHtml += '<div class="ds-row"><div class="ds-icon"><span class="material-symbols-outlined">tag</span></div><div><div class="ds-label">RUC</div><div class="ds-value">' + d.ruc + '</div></div></div>';
      detailHtml += '<div class="ds-row"><div class="ds-icon"><span class="material-symbols-outlined">location_on</span></div><div><div class="ds-label">Ubicacion</div><div class="ds-value">' + d.location + '</div></div></div>';
      detailHtml += '<div class="ds-row"><div class="ds-icon"><span class="material-symbols-outlined">schedule</span></div><div><div class="ds-label">Modalidad</div><div class="ds-value">' + d.modality + '</div></div></div>';
      detailHtml += '<div class="ds-row"><div class="ds-icon"><span class="material-symbols-outlined">payments</span></div><div><div class="ds-label">Salario</div><div class="ds-value">' + d.salary + '</div></div></div>';
      detailHtml += '</div>';

      document.getElementById('drawer-content').innerHTML = pipelineHtml + detailHtml;

      document.getElementById('drawer-overlay').classList.add('open');
      document.getElementById('drawer').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      document.getElementById('drawer-overlay').classList.remove('open');
      document.getElementById('drawer').classList.remove('open');
      document.body.style.overflow = '';
    }

    function filterApps(status) {
      var rows = document.querySelectorAll('.app-row');
      rows.forEach(function(row) {
        if(status === 'todas' || row.dataset.status === status) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
      document.querySelectorAll('.filter-tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.stat-card').forEach(function(c) { c.classList.remove('active'); });
      event.currentTarget.classList.add('active');
    }

    function applyR() {
      var w = window.innerWidth;
      var sr = document.querySelector('.stats-row');
      if(!sr) return;
      if(w < 480) sr.style.gridTemplateColumns = 'repeat(2, 1fr)';
      else if(w < 1100) sr.style.gridTemplateColumns = 'repeat(3, 1fr)';
      else sr.style.gridTemplateColumns = 'repeat(5, 1fr)';
    }
    applyR();
    window.addEventListener('resize', applyR);
