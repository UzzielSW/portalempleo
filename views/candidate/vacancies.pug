  script.
    // Bookmark toggle
    document.querySelectorAll('.bookmark-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var icon = this.querySelector('.material-symbols-outlined');
        if(this.classList.contains('saved')) {
          this.classList.remove('saved');
          icon.textContent = 'bookmark_border';
          icon.style.fontVariationSettings = '"FILL" 0';
        } else {
          this.classList.add('saved');
          icon.textContent = 'bookmark';
          icon.style.fontVariationSettings = '"FILL" 1';
        }
      });
    });

    // Card click -> detail
    document.querySelectorAll('.job-card').forEach(function(card) {
      card.addEventListener('click', function(e) {
        if(e.target.closest('.bookmark-btn')) return;
        var link = this.querySelector('.btn-view');
        if(link) window.location.href = link.getAttribute('href');
      });
    });

    // Filter tag remove
    document.querySelectorAll('.filter-tag').forEach(function(tag) {
      tag.addEventListener('click', function() { this.remove(); });
    });

    // Responsive grid
    function applyR() {
      var w = window.innerWidth;
      var g = document.querySelector('.jobs-grid');
      if(!g) return;
      if(w < 480) g.style.gridTemplateColumns = '1fr';
      else if(w < 768) g.style.gridTemplateColumns = 'repeat(2, 1fr)';
      else if(w < 1100) g.style.gridTemplateColumns = 'repeat(3, 1fr)';
      else g.style.gridTemplateColumns = 'repeat(4, 1fr)';
    }
    applyR();
    window.addEventListener('resize', applyR);
