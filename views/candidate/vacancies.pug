doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Vacantes - Portal de Empleo UP
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel='stylesheet', href='/css/style.css')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")
    style.
      :root{--up-blue:#003876;--up-blue-dark:#002147;--up-gold:#C49A1A;--up-gold-light:#e8c44d;--bg:#f0f4f8;}
      *{box-sizing:border-box;margin:0;padding:0;}
      body{font-family:'DM Sans',sans-serif;background:var(--bg);color:#1a2233;min-height:100vh;display:flex;flex-direction:column;}
      h1,h2,h3,h4{font-family:'Sora',sans-serif;}

      /* TOPBAR */
      .topbar{background:var(--up-blue);color:#fff;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,56,118,0.18);}
      .topbar-inner{max-width:1280px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px;}
      .topbar-brand{display:flex;align-items:center;gap:10px;text-decoration:none;}
      .topbar-brand-icon{background:var(--up-gold);border-radius:9px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:var(--up-blue);flex-shrink:0;}
      .topbar-brand-name{font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;}
      .topbar-nav{display:flex;align-items:center;height:100%;}
      .topbar-nav a{display:flex;align-items:center;height:100%;padding:0 1.1rem;font-size:0.82rem;font-weight:600;color:rgba(255,255,255,0.65);text-decoration:none;letter-spacing:0.03em;border-bottom:3px solid transparent;transition:color 0.2s,border-color 0.2s;}
      .topbar-nav a:hover{color:#fff;}
      .topbar-nav a.active{color:#fff;border-bottom-color:var(--up-gold);}
      .topbar-right{display:flex;align-items:center;gap:6px;}
      .topbar-icon-btn{background:rgba(255,255,255,0.08);border:none;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.75);cursor:pointer;transition:background 0.2s;position:relative;}
      .topbar-icon-btn:hover{background:rgba(255,255,255,0.16);color:#fff;}
      .notif-dot{position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--up-gold);border:2px solid var(--up-blue);}
      .topbar-divider{width:1px;height:28px;background:rgba(255,255,255,0.15);margin:0 4px;}
      .topbar-user{display:flex;align-items:center;gap:9px;cursor:pointer;padding:4px 8px;border-radius:10px;transition:background 0.2s;}
      .topbar-user:hover{background:rgba(255,255,255,0.08);}
      .topbar-user-name{font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#fff;line-height:1.1;}
      .topbar-user-role{font-size:0.6rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--up-gold-light);}
      .topbar-avatar-placeholder{width:36px;height:36px;border-radius:50%;background:var(--up-gold);display:flex;align-items:center;justify-content:center;color:var(--up-blue);font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:800;flex-shrink:0;}

      /* MAIN */
      .main-content{flex:1;max-width:1280px;margin:0 auto;width:100%;padding:2rem 1.5rem 4rem;}

      /* FILTER BAR */
      .filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:1rem 1.4rem;background:#fff;border-radius:16px;border:1.5px solid #e8edf5;margin-bottom:1.5rem;box-shadow:0 2px 8px rgba(0,56,118,0.04);}
      .filter-search{display:flex;align-items:center;gap:8px;flex:1;min-width:220px;background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:0 12px;height:42px;transition:border-color 0.2s;}
      .filter-search:focus-within{border-color:var(--up-blue);background:#fff;}
      .filter-search .material-symbols-outlined{font-size:1.05rem;color:#94a3b8;font-variation-settings:'FILL' 0;}
      .filter-search input{background:none;border:none;outline:none;font-family:'DM Sans',sans-serif;font-size:0.88rem;color:#1a2233;width:100%;}
      .filter-search input::placeholder{color:#b0bec5;}
      .filter-sep{width:1px;height:28px;background:#e2e8f0;margin:0 4px;}
      .filter-select-wrap{position:relative;display:flex;align-items:center;}
      .filter-select-wrap .material-symbols-outlined{position:absolute;left:10px;font-size:1rem;color:#64748b;font-variation-settings:'FILL' 1;pointer-events:none;}
      .filter-select{height:42px;padding:0 32px 0 34px;border-radius:10px;border:1.5px solid #e2e8f0;background:#f8fafc;font-family:'DM Sans',sans-serif;font-size:0.83rem;font-weight:600;color:#334155;cursor:pointer;outline:none;appearance:none;-webkit-appearance:none;transition:border-color 0.2s,background 0.2s;}
      .filter-select:focus{border-color:var(--up-blue);background:#fff;}
      .filter-chevron{position:absolute;right:10px;font-size:0.85rem;color:#94a3b8;pointer-events:none;}
      .btn-all-filters{display:inline-flex;align-items:center;gap:6px;height:42px;padding:0 16px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#334155;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
      .btn-all-filters:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .filter-active-tags{display:flex;flex-wrap:wrap;gap:6px;width:100%;}
      .filter-tag{display:inline-flex;align-items:center;gap:4px;background:#eff6ff;border:1px solid #bfdbfe;color:var(--up-blue);font-size:0.72rem;font-weight:700;padding:3px 10px;border-radius:50px;cursor:pointer;}
      .filter-tag:hover{background:#dbeafe;}
      .filter-tag .material-symbols-outlined{font-size:0.78rem;}

      /* RESULTS HEADER */
      .results-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.2rem;}
      .results-title{font-family:'Sora',sans-serif;font-size:1.5rem;font-weight:800;color:#0f172a;}
      .results-count{font-size:0.85rem;color:#64748b;margin-top:2px;}
      .sort-wrap{display:flex;align-items:center;gap:8px;}
      .sort-label{font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#94a3b8;}
      .sort-select{height:38px;padding:0 32px 0 12px;border-radius:9px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#334155;cursor:pointer;outline:none;appearance:none;-webkit-appearance:none;}

      /* JOBS GRID */
      .jobs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}

      /* JOB CARD */
      .job-card{background:#fff;border-radius:16px;border:1.5px solid #e8edf5;padding:1.3rem;display:flex;flex-direction:column;gap:0.8rem;transition:border-color 0.2s,box-shadow 0.2s,transform 0.2s;cursor:pointer;position:relative;}
      .job-card:hover{border-color:rgba(0,56,118,0.3);box-shadow:0 6px 24px rgba(0,56,118,0.09);transform:translateY(-2px);}
      .job-card-top{display:flex;align-items:flex-start;justify-content:space-between;}
      .job-logo{width:44px;height:44px;border-radius:10px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:var(--up-blue);flex-shrink:0;overflow:hidden;border:1px solid #e8edf5;}
      .bookmark-btn{background:none;border:none;cursor:pointer;color:#94a3b8;padding:2px;transition:color 0.2s;}
      .bookmark-btn:hover{color:var(--up-gold);}
      .bookmark-btn.saved{color:var(--up-gold);}
      .bookmark-btn .material-symbols-outlined{font-size:1.2rem;}
      .job-title{font-family:'Sora',sans-serif;font-size:0.92rem;font-weight:800;color:#0f172a;line-height:1.3;}
      .job-company{font-size:0.78rem;font-weight:600;color:#64748b;margin-top:1px;letter-spacing:0.02em;}
      .job-location{display:flex;align-items:center;gap:4px;font-size:0.75rem;color:#94a3b8;}
      .job-location .material-symbols-outlined{font-size:0.9rem;color:var(--up-blue);font-variation-settings:'FILL' 1;}
      .job-tags{display:flex;flex-wrap:wrap;gap:5px;}
      .job-tag{display:inline-flex;font-size:0.65rem;font-weight:700;padding:3px 9px;border-radius:50px;letter-spacing:0.07em;text-transform:uppercase;}
      .tag-full{background:#eff6ff;color:#1e40af;}
      .tag-part{background:#f0fdf4;color:#15803d;}
      .tag-remote{background:#faf5ff;color:#6d28d9;}
      .tag-hybrid{background:#fff7ed;color:#92400e;}
      .tag-urgent{background:#fef2f2;color:#dc2626;}
      .tag-contract{background:#f8fafc;color:#475569;}
      .tag-faculty{background:#fefce8;color:#854d0e;}
      .job-footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:0.6rem;border-top:1px solid #f8fafc;}
      .job-date{font-size:0.72rem;color:#94a3b8;}
      .btn-view{display:inline-flex;align-items:center;gap:4px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:700;color:var(--up-blue);text-decoration:none;transition:color 0.2s,gap 0.2s;}
      .btn-view:hover{color:var(--up-gold);gap:7px;}
      .btn-view .material-symbols-outlined{font-size:0.9rem;}

      /* PAGINATION */
      .pagination{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:2.5rem;}
      .page-btn{width:38px;height:38px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#334155;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;}
      .page-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .page-btn.active{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .page-btn.nav{color:#64748b;}
      .page-dots{color:#94a3b8;font-size:0.85rem;padding:0 4px;}

      /* EMPTY STATE */
      .empty-state{text-align:center;padding:4rem 2rem;color:#94a3b8;}
      .empty-state .material-symbols-outlined{font-size:3rem;margin-bottom:1rem;color:#cbd5e1;}
      .empty-title{font-family:'Sora',sans-serif;font-size:1rem;font-weight:700;color:#475569;margin-bottom:0.4rem;}

      /* FOOTER */
      .footer-strip{background:#fff;border-top:1px solid #e8edf5;padding:1rem 1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.5rem;font-size:0.72rem;color:#94a3b8;}
      .footer-brand{display:flex;align-items:center;gap:6px;opacity:0.6;}

      /* RESPONSIVE */
      @media(max-width:1100px){.jobs-grid{grid-template-columns:repeat(3,1fr);}}
      @media(max-width:768px){.jobs-grid{grid-template-columns:repeat(2,1fr);}.topbar-nav{display:none;}}
      @media(max-width:480px){.jobs-grid{grid-template-columns:1fr;}}

