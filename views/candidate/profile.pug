doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Perfil - Portal de Empleo UP
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel='stylesheet', href='/css/style.css')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")
    style.
      :root{--up-blue:#003876;--up-blue-dark:#002147;--up-gold:#C49A1A;--up-gold-light:#e8c44d;--bg:#f0f4f8;}
      *{box-sizing:border-box;margin:0;padding:0;}
      body{font-family:'DM Sans',sans-serif;background:var(--bg);color:#1a2233;min-height:100vh;display:flex;flex-direction:column;}
      h1,h2,h3,h4{font-family:'Sora',sans-serif;}

      /* ===== TOPBAR ===== */
      .topbar{background:var(--up-blue);color:#fff;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,56,118,0.18);}
      .topbar-inner{max-width:1280px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px;}
      .topbar-brand{display:flex;align-items:center;gap:10px;text-decoration:none;}
      .topbar-brand-icon{background:var(--up-gold);border-radius:9px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:var(--up-blue);flex-shrink:0;}
      .topbar-brand-name{font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;letter-spacing:0.01em;}
      .topbar-nav{display:flex;align-items:center;height:100%;}
      .topbar-nav a{display:flex;align-items:center;height:100%;padding:0 1.1rem;font-size:0.82rem;font-weight:600;color:rgba(255,255,255,0.65);text-decoration:none;letter-spacing:0.03em;border-bottom:3px solid transparent;transition:color 0.2s,border-color 0.2s;}
      .topbar-nav a:hover{color:#fff;}
      .topbar-nav a.active{color:#fff;border-bottom-color:var(--up-gold);}
      .topbar-right{display:flex;align-items:center;gap:6px;}
      .topbar-icon-btn{background:rgba(255,255,255,0.08);border:none;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.75);cursor:pointer;transition:background 0.2s,color 0.2s;position:relative;}
      .topbar-icon-btn:hover{background:rgba(255,255,255,0.16);color:#fff;}
      .notif-dot{position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--up-gold);border:2px solid var(--up-blue);}
      .topbar-divider{width:1px;height:28px;background:rgba(255,255,255,0.15);margin:0 4px;}
      .topbar-user{display:flex;align-items:center;gap:9px;cursor:pointer;padding:4px 8px;border-radius:10px;transition:background 0.2s;}
      .topbar-user:hover{background:rgba(255,255,255,0.08);}
      .topbar-user-info{text-align:right;}
      .topbar-user-name{font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#fff;line-height:1.1;}
      .topbar-user-role{font-size:0.6rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--up-gold-light);}
      .topbar-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid rgba(196,154,26,0.5);}
      .topbar-avatar-placeholder{width:36px;height:36px;border-radius:50%;background:var(--up-gold);display:flex;align-items:center;justify-content:center;color:var(--up-blue);font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:800;flex-shrink:0;}

      /* ===== MAIN LAYOUT ===== */
      .main-content{flex:1;max-width:1280px;margin:0 auto;width:100%;padding:2rem 1.5rem 4rem;}
      .profile-grid{display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start;}

      /* ===== CARDS ===== */
      .card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;box-shadow:0 2px 12px rgba(0,56,118,0.05);}
      .card-header{padding:1rem 1.4rem;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;}
      .card-header-left{display:flex;align-items:center;gap:8px;}
      .card-header-icon{width:30px;height:30px;border-radius:8px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:var(--up-blue);}
      .card-header-icon .material-symbols-outlined{font-size:0.95rem;font-variation-settings:'FILL' 1;}
      .card-header-title{font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;color:#0f172a;letter-spacing:0.08em;text-transform:uppercase;}
      .card-action{display:inline-flex;align-items:center;gap:4px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:700;color:var(--up-blue);background:none;border:none;cursor:pointer;text-decoration:none;transition:color 0.2s;}
      .card-action:hover{color:var(--up-gold);}
      .card-body{padding:1.4rem;}

      /* ===== HERO CARD ===== */
      .hero-card{padding:2rem;display:flex;flex-wrap:wrap;gap:2rem;align-items:flex-start;margin-bottom:1.5rem;}
      .hero-avatar-wrap{position:relative;flex-shrink:0;}
      .hero-avatar{width:110px;height:110px;border-radius:18px;object-fit:cover;border:4px solid #fff;box-shadow:0 4px 20px rgba(0,56,118,0.15);}
      .hero-avatar-placeholder{width:110px;height:110px;border-radius:18px;background:linear-gradient(135deg,var(--up-blue),var(--up-blue-dark));display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Sora',sans-serif;font-size:2.5rem;font-weight:800;border:4px solid #fff;box-shadow:0 4px 20px rgba(0,56,118,0.15);}
      .status-badge{position:absolute;bottom:-10px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#dcfce7;color:#15803d;border:1px solid #bbf7d0;font-size:0.6rem;font-weight:800;letter-spacing:0.12em;padding:3px 10px;border-radius:50px;display:flex;align-items:center;gap:4px;}
      .status-dot{width:5px;height:5px;border-radius:50%;background:#22c55e;animation:pulse 2s infinite;}
      @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}
      .hero-info{flex:1;min-width:200px;}
      .hero-name{font-family:'Sora',sans-serif;font-size:1.7rem;font-weight:800;color:#0f172a;margin-bottom:4px;}
      .hero-title-role{font-size:0.9rem;color:#64748b;margin-bottom:0.8rem;display:flex;align-items:center;gap:6px;}
      .hero-meta-row{display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1rem;}
      .hero-meta-item{display:flex;align-items:center;gap:5px;font-size:0.8rem;color:#64748b;}
      .hero-meta-item .material-symbols-outlined{font-size:1rem;color:var(--up-blue);font-variation-settings:'FILL' 1;}
      .hero-meta-item strong{color:#334155;}
      .hero-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:0.8rem;}
      .btn-edit{display:inline-flex;align-items:center;gap:6px;background:#f8fafc;border:1.5px solid #e2e8f0;color:#334155;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;padding:6px 14px;border-radius:9px;cursor:pointer;text-decoration:none;transition:all 0.2s;}
      .btn-edit:hover{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .btn-social{width:34px;height:34px;border-radius:9px;background:#f1f5f9;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;color:#64748b;text-decoration:none;transition:all 0.2s;}
      .btn-social:hover{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .btn-social svg{width:14px;height:14px;fill:currentColor;}
      .hero-score{background:#f8fafc;border:1.5px solid #e8edf5;border-radius:16px;padding:1.2rem 1.5rem;text-align:center;min-width:140px;display:flex;flex-direction:column;align-items:center;gap:4px;}
      .hero-score-num{font-family:'Sora',sans-serif;font-size:2.2rem;font-weight:800;color:var(--up-blue);line-height:1;}
      .hero-score-stars{display:flex;gap:2px;margin:4px 0;}
      .hero-score-stars .material-symbols-outlined{font-size:1rem;color:var(--up-gold);}
      .hero-score-divider{width:100%;height:1px;background:#e8edf5;margin:6px 0;}
      .hero-score-label{font-size:0.6rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#94a3b8;}
      .hero-score-count{font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:800;color:#0f172a;}

      /* ===== STATS ROW ===== */
      .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:1.5rem;}
      .stat-card{background:#fff;border-radius:14px;border:1.5px solid #e8edf5;padding:1rem 1.2rem;display:flex;align-items:center;gap:12px;}
      .stat-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
      .stat-icon .material-symbols-outlined{font-size:1.1rem;font-variation-settings:'FILL' 1;}
      .stat-icon-blue{background:#eff6ff;color:var(--up-blue);}
      .stat-icon-gold{background:#fefce8;color:#a16207;}
      .stat-icon-green{background:#f0fdf4;color:#15803d;}
      .stat-icon-purple{background:#faf5ff;color:#7c3aed;}
      .stat-num{font-family:'Sora',sans-serif;font-size:1.3rem;font-weight:800;color:#0f172a;line-height:1;}
      .stat-label{font-size:0.72rem;color:#94a3b8;margin-top:1px;}

      /* ===== EXPERIENCE ===== */
      .exp-item{display:flex;gap:12px;padding:1rem 0;border-bottom:1px solid #f8fafc;}
      .exp-item:last-child{border-bottom:none;padding-bottom:0;}
      .exp-icon{width:38px;height:38px;border-radius:10px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#64748b;flex-shrink:0;}
      .exp-icon .material-symbols-outlined{font-size:1.1rem;font-variation-settings:'FILL' 1;}
      .exp-title{font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:700;color:#0f172a;}
      .exp-company{font-size:0.8rem;color:var(--up-blue);font-weight:600;}
      .exp-date{font-size:0.72rem;color:#94a3b8;margin-top:2px;}
      .exp-desc{font-size:0.8rem;color:#64748b;line-height:1.6;margin-top:4px;}
      .exp-badge{display:inline-flex;font-size:0.65rem;font-weight:700;padding:2px 9px;border-radius:50px;letter-spacing:0.08em;}
      .badge-current{background:#dcfce7;color:#15803d;}
      .badge-done{background:#f1f5f9;color:#64748b;}

      /* ===== ACADEMIC ===== */
      .acad-item{display:flex;gap:12px;padding:1rem 0;border-bottom:1px solid #f8fafc;}
      .acad-item:last-child{border-bottom:none;padding-bottom:0;}
      .acad-icon{width:38px;height:38px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:var(--up-blue);flex-shrink:0;}
      .acad-icon .material-symbols-outlined{font-size:1.1rem;font-variation-settings:'FILL' 1;}
      .acad-title{font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:700;color:#0f172a;}
      .acad-inst{font-size:0.8rem;color:var(--up-blue);font-weight:600;}
      .acad-date{font-size:0.72rem;color:#94a3b8;margin-top:2px;}
      .acad-detail{font-size:0.78rem;color:#64748b;margin-top:3px;}

      /* ===== SKILLS ===== */
      .skills-wrap{display:flex;flex-wrap:wrap;gap:7px;}
      .skill-tag{display:inline-flex;align-items:center;gap:4px;background:#f0f4ff;border:1px solid #dbeafe;color:var(--up-blue);font-size:0.75rem;font-weight:600;padding:4px 11px;border-radius:50px;}
      .skill-tag .material-symbols-outlined{font-size:0.8rem;}

      /* ===== DOCS ===== */
      .doc-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
      .doc-file{display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f8fafc;border-radius:12px;border:1.5px solid #e8edf5;}
      .doc-file-icon{width:36px;height:36px;background:#fee2e2;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
      .doc-file-icon .material-symbols-outlined{font-size:1rem;color:#dc2626;font-variation-settings:'FILL' 1;}
      .doc-file-name{font-size:0.8rem;font-weight:700;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .doc-file-meta{font-size:0.68rem;color:#94a3b8;font-weight:600;text-transform:uppercase;}
      .doc-upload{display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border:2px dashed #d1d9e6;border-radius:12px;background:#fafbfc;cursor:pointer;transition:border-color 0.2s,background 0.2s;font-size:0.8rem;color:#64748b;font-weight:600;}
      .doc-upload:hover{border-color:var(--up-blue);background:#f0f5ff;color:var(--up-blue);}

      /* ===== SIDEBAR CARDS ===== */
      .info-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f8fafc;}
      .info-row:last-child{border-bottom:none;}
      .info-row-icon{color:#94a3b8;margin-top:1px;flex-shrink:0;}
      .info-row-icon .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .info-row-label{font-size:0.62rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#94a3b8;}
      .info-row-value{font-size:0.83rem;font-weight:600;color:#334155;}

      /* ===== LANGUAGES ===== */
      .lang-row{margin-bottom:1rem;}
      .lang-row:last-child{margin-bottom:0;}
      .lang-header{display:flex;justify-content:space-between;margin-bottom:5px;}
      .lang-name{font-size:0.83rem;font-weight:700;color:#0f172a;}
      .lang-level{font-size:0.7rem;font-weight:700;text-transform:uppercase;color:var(--up-blue);letter-spacing:0.06em;}
      .lang-bar-bg{height:5px;background:#f1f5f9;border-radius:3px;}
      .lang-bar{height:5px;border-radius:3px;background:linear-gradient(to right,var(--up-blue),var(--up-gold));}

      /* ===== PROFILE COMPLETION ===== */
      .completion-card{background:linear-gradient(135deg,var(--up-blue) 0%,var(--up-blue-dark) 100%);border-radius:18px;padding:1.4rem;color:#fff;position:relative;overflow:hidden;}
      .completion-card::before{content:'';position:absolute;bottom:-30px;right:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,0.04);}
      .completion-title{font-family:'Sora',sans-serif;font-size:0.9rem;font-weight:800;color:#fff;}
      .completion-pct{font-family:'Sora',sans-serif;font-size:0.9rem;font-weight:800;color:var(--up-gold-light);}
      .completion-bar-bg{height:6px;background:rgba(255,255,255,0.15);border-radius:3px;margin:10px 0 14px;}
      .completion-bar{height:6px;border-radius:3px;background:var(--up-gold);}
      .completion-item{display:flex;align-items:center;gap:7px;font-size:0.78rem;margin-bottom:7px;}
      .completion-item .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .ci-done{color:#4ade80;}
      .ci-pending{color:rgba(255,255,255,0.3);}
      .btn-update{width:100%;margin-top:1.2rem;padding:0.7rem;background:var(--up-gold);color:#fff;border:none;border-radius:10px;font-family:'Sora',sans-serif;font-size:0.85rem;font-weight:700;cursor:pointer;transition:background 0.2s;}
      .btn-update:hover{background:var(--up-gold-light);color:var(--up-blue);}

      /* ===== FOOTER ===== */
      .footer-strip{background:#fff;border-top:1px solid #e8edf5;padding:1rem 1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.5rem;font-size:0.72rem;color:#94a3b8;}
      .footer-brand{display:flex;align-items:center;gap:6px;opacity:0.6;}

      /* ===== MODAL ===== */
      .modal-overlay{position:fixed;inset:0;background:rgba(0,20,50,0.65);backdrop-filter:blur(6px);z-index:500;display:flex;align-items:center;justify-content:center;padding:1rem;}
      .modal-box{background:#fff;border-radius:22px;box-shadow:0 24px 80px rgba(0,0,0,0.18);width:100%;max-width:560px;overflow:hidden;}
      .modal-header{background:linear-gradient(135deg,var(--up-blue) 0%,var(--up-blue-dark) 100%);padding:1.8rem 2rem;display:flex;align-items:center;gap:14px;position:relative;overflow:hidden;}
      .modal-header::after{content:'';position:absolute;top:-40px;right:-40px;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,0.05);}
      .modal-header-icon{width:46px;height:46px;border-radius:13px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;color:var(--up-gold-light);flex-shrink:0;position:relative;z-index:1;}
      .modal-header-icon .material-symbols-outlined{font-size:1.4rem;font-variation-settings:'FILL' 1;}
      .modal-header-title{font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:800;color:#fff;position:relative;z-index:1;}
      .modal-header-sub{font-size:0.75rem;color:rgba(255,255,255,0.6);margin-top:2px;position:relative;z-index:1;}
      .modal-body{padding:1.8rem 2rem;max-height:55vh;overflow-y:auto;}
      .modal-body::-webkit-scrollbar{width:5px;}
      .modal-body::-webkit-scrollbar-track{background:#f1f5f9;}
      .modal-body::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px;}
      .modal-intro{font-size:0.88rem;color:#475569;line-height:1.75;margin-bottom:1.4rem;}
      .modal-section-title{font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:800;color:var(--up-blue);margin:1.2rem 0 0.6rem;display:flex;align-items:center;gap:6px;}
      .modal-section-title .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .modal-text{font-size:0.82rem;color:#64748b;line-height:1.75;}
      .modal-text li{margin-bottom:4px;padding-left:4px;}
      .modal-highlight{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:10px 14px;font-size:0.8rem;color:#1e3a5f;line-height:1.65;margin-top:1rem;}
      .modal-highlight .material-symbols-outlined{font-size:0.9rem;color:var(--up-blue);vertical-align:middle;margin-right:4px;font-variation-settings:'FILL' 1;}
      .modal-footer{padding:1.2rem 2rem 1.6rem;border-top:1px solid #f1f5f9;display:flex;flex-direction:column;gap:10px;}
      .modal-check-row{display:flex;align-items:flex-start;gap:8px;}
      .modal-check-row input[type='checkbox']{width:15px;height:15px;margin-top:2px;accent-color:var(--up-blue);cursor:pointer;flex-shrink:0;}
      .modal-check-label{font-size:0.78rem;color:#475569;line-height:1.6;cursor:pointer;}
      .modal-check-label a{color:var(--up-blue);font-weight:600;text-decoration:none;}
      .modal-check-label a:hover{color:var(--up-gold);}
      .modal-actions{display:flex;gap:10px;margin-top:6px;}
      .btn-accept{flex:1;height:46px;background:var(--up-blue);color:#fff;border:none;border-radius:11px;font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:background 0.2s,opacity 0.2s;}
      .btn-accept:disabled{opacity:0.45;cursor:not-allowed;}
      .btn-accept:not(:disabled):hover{background:var(--up-gold);}
      .btn-decline{height:46px;padding:0 1.2rem;background:#f1f5f9;color:#64748b;border:none;border-radius:11px;font-family:'Sora',sans-serif;font-size:0.85rem;font-weight:700;cursor:pointer;transition:background 0.2s,color 0.2s;white-space:nowrap;}
      .btn-decline:hover{background:#fee2e2;color:#dc2626;}

      /* ===== RESPONSIVE ===== */
      @media(max-width:1024px){.profile-grid{grid-template-columns:1fr;}.stats-row{grid-template-columns:1fr 1fr;}}
      @media(max-width:640px){.stats-row{grid-template-columns:1fr 1fr;}.topbar-nav{display:none;}.hero-card{padding:1.2rem;}.doc-row{grid-template-columns:1fr;}.modal-body{max-height:45vh;}.modal-footer,.modal-body{padding:1.2rem;}}

  //- ===== CONSENT MODAL =====
  #consent-modal.modal-overlay
    .modal-box
      .modal-header
        .modal-header-icon
          span.material-symbols-outlined security
        div
          .modal-header-title Consentimiento de Uso de Datos
          .modal-header-sub Portal de Empleo UP &mdash; Universidad de Panama
      .modal-body
        p.modal-intro
          | Antes de acceder al Portal de Empleo UP, la Universidad de Panama requiere su consentimiento expreso para el tratamiento de sus datos personales, de conformidad con la&nbsp;
          strong Ley 81 de 2019 sobre Proteccion de Datos Personales
          | &nbsp;de la Republica de Panama.
        .modal-section-title
          span.material-symbols-outlined info
          | Que datos recopilamos
        ul.modal-text(style='padding-left:1rem;list-style:disc')
          li Datos de identificacion: nombre, cedula o carnet estudiantil, correo institucional.
          li Informacion academica: facultad, carrera, año de ingreso y estado academico.
          li Historial de postulaciones y actividad dentro del portal.
          li Documentos cargados voluntariamente (CV, certificados).
          li Datos de contacto: telefono y ubicacion general.
        .modal-section-title
          span.material-symbols-outlined manage_accounts
          | Como usamos sus datos
