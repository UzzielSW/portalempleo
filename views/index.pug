  //- ============================================================
  //- SCRIPTS
  //- ============================================================
  script.
    // Mobile menu toggle
    function toggleMenu() {
      var nav = document.querySelector('.nav-desktop');
      nav.classList.toggle('open');
    }

    // Responsive grid fixes
    function applyResponsive() {
      var w = window.innerWidth;
      var stepsGrid = document.querySelector('.steps-section .hs-container > div:last-child');
      var jobsGrids = document.querySelectorAll('.jobs-grid');
      var howGrid = document.querySelector('.how-grid');
      var testiGrid = document.querySelector('.testimonials-grid');
      var eventsGrid = document.querySelector('.events-grid');
      var footerGrid = document.querySelector('.footer-main .hs-container > div');

      if (stepsGrid) stepsGrid.style.gridTemplateColumns = w < 640 ? '1fr' : 'repeat(3, 1fr)';
      jobsGrids.forEach(function(g) { g.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? '1fr 1fr' : 'repeat(3, 1fr)'; });
      if (howGrid) howGrid.style.gridTemplateColumns = w < 768 ? '1fr' : '1fr 1fr';
      if (testiGrid) testiGrid.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? '1fr 1fr' : 'repeat(3, 1fr)';
      if (eventsGrid) eventsGrid.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? '1fr 1fr' : 'repeat(3, 1fr)';
      if (footerGrid) footerGrid.style.gridTemplateColumns = w < 768 ? '1fr' : w < 1024 ? '1fr 1fr' : '2fr 1fr 1fr 1fr';
    }

    applyResponsive();
    window.addEventListener('resize', applyResponsive);
