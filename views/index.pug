doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Portal de Empleo UP | Universidad de Panamá
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel='stylesheet', href='/css/style.css')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")

    style.
      :root {
        --up-blue: #003876;
        --up-blue-dark: #002147;
        --up-blue-mid: #004a9f;
        --up-gold: #C49A1A;
        --up-gold-light: #e8c44d;
      }

      * { box-sizing: border-box; }

      body {
        font-family: 'DM Sans', sans-serif;
        background: #f5f7fa;
        color: #1a2233;
        margin: 0;
      }

      h1, h2, h3, h4, h5, .display {
        font-family: 'Sora', sans-serif;
      }

      /* NAV */
      .nav-portal {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid #e2e8f0;
      }

      .nav-logo-icon {
        background: var(--up-blue);
        color: var(--up-gold);
        border-radius: 10px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .nav-logo-title {
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        color: var(--up-blue);
        line-height: 1.1;
      }

      .nav-logo-sub {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--up-gold);
      }

      .nav-link {
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        letter-spacing: 0.04em;
        transition: color 0.2s;
      }

      .nav-link:hover { color: var(--up-gold); }

      .nav-link-active {
        color: var(--up-blue);
        border-bottom: 2px solid var(--up-gold);
        padding-bottom: 2px;
      }

      .btn-login {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--up-blue);
        text-decoration: none;
        transition: color 0.2s;
      }

      .btn-login:hover { color: var(--up-gold); }

      .btn-register {
        background: var(--up-blue);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 0.5rem 1.4rem;
        border-radius: 50px;
        text-decoration: none;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 10px rgba(0,56,118,0.2);
      }

      .btn-register:hover {
        background: var(--up-gold);
        color: #fff;
      }

      /* HERO CINEMATIC */
      .hero-new {
        position: relative;
        min-height: 90vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
      }

      .hero-slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        animation: heroFade 20s linear infinite;
      }

      .hero-slide:nth-child(1) { animation-delay: 0s; }
      .hero-slide:nth-child(2) { animation-delay: 5s; }
      .hero-slide:nth-child(3) { animation-delay: 10s; }
      .hero-slide:nth-child(4) { animation-delay: 15s; }

      @keyframes heroFade {
        0%    { opacity: 0; transform: scale(1); }
        5%    { opacity: 1; }
        20%   { opacity: 1; transform: scale(1.04); }
        25%   { opacity: 0; transform: scale(1.06); }
        100%  { opacity: 0; transform: scale(1); }
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(160deg, rgba(0,21,54,0.88) 0%, rgba(0,56,118,0.62) 45%, rgba(0,21,54,0.80) 100%);
        z-index: 1;
      }

      .hero-overlay-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 180px;
        background: linear-gradient(to top, rgba(0,18,46,0.7) 0%, transparent 100%);
        z-index: 1;
      }

      .hero-new-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 6rem 1.5rem 8rem;
        max-width: 1100px;
        margin: 0 auto;
        width: 100%;
      }

      .hero-new-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(12px);
        color: var(--up-gold-light);
        font-size: 0.67rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 6px 18px;
        border-radius: 50px;
        border: 1px solid rgba(196,154,26,0.4);
        margin-bottom: 1.5rem;
      }

      .hero-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--up-gold-light);
        flex-shrink: 0;
      }

      .hero-new-title {
        font-family: 'Sora', sans-serif;
        font-size: clamp(2.8rem, 6vw, 5rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.06;
        margin: 0 0 1.2rem;
        text-shadow: 0 2px 24px rgba(0,0,0,0.4);
      }

      .hero-new-title-accent {
        color: var(--up-gold-light);
        display: block;
      }

      .hero-new-desc {
        color: rgba(255,255,255,0.78);
        font-size: 1.08rem;
        line-height: 1.7;
        max-width: 560px;
        margin: 0 auto 2.4rem;
      }

      /* SEARCH BOX GLASS */
      .search-box-glass {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(16px);
        border-radius: 16px;
        padding: 8px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 0 0 1px rgba(255,255,255,0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-width: 680px;
        margin: 0 auto 2rem;
      }

      .search-field-glass {
        flex: 1;
        min-width: 160px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.12);
        border-radius: 10px;
        padding: 12px 16px;
        border: 1px solid rgba(255,255,255,0.14);
      }

      .search-field-glass .material-symbols-outlined {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.55);
        font-variation-settings: 'FILL' 0, 'wght' 400;
        flex-shrink: 0;
      }

      .search-field-glass input,
      .search-field-glass select {
        background: transparent;
        border: none;
        outline: none;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        color: #fff;
        width: 100%;
      }

      .search-field-glass input::placeholder { color: rgba(255,255,255,0.45); }
      .search-field-glass select { cursor: pointer; }
      .search-field-glass select option { color: #1a2233; background: #fff; }

      .btn-search-glass {
        background: var(--up-gold);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px 28px;
        font-family: 'Sora', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }

      .btn-search-glass:hover {
        background: var(--up-gold-light);
        transform: translateY(-1px);
      }

      /* INDUSTRY PILLS */
      .hero-industries {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
      }

      .hero-industry-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.72);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 5px 14px;
        border-radius: 50px;
        cursor: default;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }

      .hero-industry-pill:hover {
        background: rgba(196,154,26,0.2);
        border-color: rgba(196,154,26,0.5);
        color: var(--up-gold-light);
      }

      .hero-industry-pill .material-symbols-outlined { font-size: 0.9rem; }

      /* HERO STATS BAR */
      .hero-stats-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 2;
        background: rgba(0,18,46,0.55);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255,255,255,0.07);
      }

      .hero-stats-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.2rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2.5rem;
      }

      .hero-stat-item { display: flex; align-items: center; gap: 10px; }

      .hero-stat-num {
        font-family: 'Sora', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
      }

      .hero-stat-txt {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.48);
        max-width: 80px;
        line-height: 1.3;
      }

      .hero-stat-bar-divider {
        width: 1px;
        height: 32px;
        background: rgba(255,255,255,0.12);
      }

      /* TICKER / PARTNERS */
      .ticker-section {
        background: #fff;
        padding: 2.5rem 0 2rem;
        border-bottom: 1px solid #f1f5f9;
        overflow: hidden;
      }

      .ticker-label {
        text-align: center;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 2rem;
      }

      .ticker-wrap {
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      }

      .ticker-track {
        display: flex;
        width: max-content;
        gap: 5rem;
        align-items: center;
        animation: ticker-scroll 30s linear infinite;
      }

      .ticker-track:hover { animation-play-state: paused; }

      @keyframes ticker-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      .ticker-logo {
        height: 26px;
        object-fit: contain;
        opacity: 0.38;
        filter: grayscale(1);
        transition: opacity 0.3s, filter 0.3s;
        flex-shrink: 0;
      }

      .ticker-logo:hover {
        opacity: 0.85;
        filter: grayscale(0);
      }

      /* FOOTER */
      .footer-main {
        background: var(--up-blue-dark);
        padding: 4rem 1rem 0;
      }

      .footer-brand-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: 0.04em;
      }

      .footer-brand-desc {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.5);
        line-height: 1.7;
        margin-top: 0.8rem;
      }

      .footer-social {
        display: flex;
        gap: 10px;
        margin-top: 1.2rem;
      }

      .footer-social-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.6);
        transition: background 0.2s, color 0.2s;
      }

      .footer-social-btn:hover { background: var(--up-gold); color: #fff; border-color: transparent; }

      .footer-col-title {
        font-family: 'Sora', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--up-gold-light);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(196,154,26,0.25);
      }

      .footer-link {
        display: block;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        margin-bottom: 0.65rem;
        transition: color 0.2s;
      }

      .footer-link:hover { color: var(--up-gold-light); }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        margin-top: 3rem;
        padding: 1.2rem 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
      }

      .footer-bottom-text {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.35);
      }

      /* MOBILE MENU */
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--up-blue);
        padding: 4px;
      }

      /* ====== TICKER SEPARADORES ====== */
      .ticker-section-divider {
        display: inline-flex;
        align-items: center;
        color: rgba(196,154,26,0.5);
        flex-shrink: 0;
      }

      .step-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 20px;
        padding: 2.2rem 1.8rem;
        text-align: center;
        box-shadow: 0 2px 18px rgba(0,56,118,0.06);
        transition: transform 0.25s, box-shadow 0.25s;
        position: relative;
        overflow: hidden;
      }

      .step-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(to right, var(--up-blue), var(--up-blue-mid));
      }

      .step-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 40px rgba(0,56,118,0.14);
      }

      .step-number-wrap {
        width: 60px;
        height: 60px;
        background: var(--up-blue);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Sora', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0 auto 1.4rem;
        box-shadow: 0 6px 20px rgba(0,56,118,0.3);
        position: relative;
        z-index: 1;
      }

      .step-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.08rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.6rem;
      }

      .step-desc {
        font-size: 0.87rem;
        color: #64748b;
        line-height: 1.65;
      }

      .steps-section {
        background: #fff;
        padding: 5rem 1rem;
      }

      .section-label {
        display: block;
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--up-gold);
        margin-bottom: 0.8rem;
      }

      .section-title {
        font-family: 'Sora', sans-serif;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 800;
        color: #0f172a;
        text-align: center;
        margin: 0 0 1rem;
        line-height: 1.2;
      }

      .section-desc {
        text-align: center;
        color: #64748b;
        font-size: 1rem;
        line-height: 1.7;
        max-width: 600px;
        margin: 0 auto 3rem;
      }

      /* ======================================
         SECCION: VACANTES DESTACADAS
         ====================================== */
      .jobs-section {
        background: #f0f4fa;
        padding: 5rem 1rem;
      }

      .job-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: 0 2px 14px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
      }

      .job-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 32px rgba(0,56,118,0.12);
        border-color: #cbd5e1;
      }

      .job-card-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
      }

      .job-company-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--up-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--up-gold-light);
        flex-shrink: 0;
      }

      .job-company-name {
        font-size: 0.78rem;
        font-weight: 600;
        color: #64748b;
      }

      .job-title {
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
        margin-top: 2px;
      }

      .job-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 600;
        flex-shrink: 0;
      }

      .job-badge-new {
        background: rgba(0,56,118,0.1);
        color: var(--up-blue);
      }

      .job-badge-pasantia {
        background: rgba(196,154,26,0.12);
        color: #9a7a0a;
      }

      .job-badge-remoto {
        background: rgba(16,185,129,0.1);
        color: #059669;
      }

      .job-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .job-meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.76rem;
        color: #94a3b8;
      }

      .job-meta-item .material-symbols-outlined { font-size: 0.9rem; }

      .btn-job-apply {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--up-blue);
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.55rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s;
        align-self: flex-start;
        margin-top: auto;
      }

      .btn-job-apply:hover { background: var(--up-gold); }

      /* ======================================
         SECCION: COMO FUNCIONA (EMPLEADORES)
         ====================================== */
      .how-section {
        background: var(--up-blue-dark);
        padding: 5rem 1rem;
        position: relative;
        overflow: hidden;
      }

      .how-section::before {
        content: '';
        position: absolute;
        top: -100px; right: -100px;
        width: 400px; height: 400px;
        border-radius: 50%;
        background: rgba(255,255,255,0.03);
      }

      .how-section::after {
        content: '';
        position: absolute;
        bottom: -80px; left: -60px;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: rgba(196,154,26,0.06);
      }

      .how-feature {
        display: flex;
        gap: 1.2rem;
        align-items: flex-start;
      }

      .how-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--up-gold-light);
        flex-shrink: 0;
        margin-top: 2px;
      }

      .how-feature-title {
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 0.4rem;
      }

      .how-feature-desc {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.55);
        line-height: 1.65;
      }

      .how-image-card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 24px;
        overflow: hidden;
        position: relative;
      }

      /* ======================================
         SECCION: TESTIMONIOS
         ====================================== */
      .testimonials-section {
        background: #fff;
        padding: 5rem 1rem;
      }

      .testimonial-card {
        background: #f8fafc;
        border: 1px solid #e8edf5;
        border-radius: 20px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        transition: box-shadow 0.2s;
      }

      .testimonial-card:hover {
        box-shadow: 0 8px 30px rgba(0,56,118,0.1);
      }

      .testimonial-quote {
        font-size: 2rem;
        color: var(--up-gold);
        line-height: 1;
        font-family: Georgia, serif;
      }

      .testimonial-text {
        font-size: 0.9rem;
        color: #475569;
        line-height: 1.7;
        flex: 1;
      }

      .testimonial-author {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
      }

      .testimonial-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e2e8f0;
      }

      .testimonial-avatar-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--up-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--up-gold-light);
        flex-shrink: 0;
      }

      .testimonial-name {
        font-family: 'Sora', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        color: #0f172a;
      }

      .testimonial-role {
        font-size: 0.75rem;
        color: #94a3b8;
      }

      .stars {
        display: flex;
        gap: 2px;
        color: var(--up-gold);
        font-size: 0.85rem;
      }

      /* ======================================
         SECCION: FERIA DE EMPLEO
         ====================================== */
      .events-section {
        background: #f0f4fa;
        padding: 5rem 1rem;
      }

      .event-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 2px 14px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 36px rgba(0,56,118,0.12);
      }

      .event-card-img {
        height: 170px;
        object-fit: cover;
        width: 100%;
      }

      .event-card-body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }

      .event-date-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,56,118,0.08);
        color: var(--up-blue);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 50px;
        margin-bottom: 0.8rem;
      }

      .event-date-badge .material-symbols-outlined { font-size: 0.85rem; }

      .event-title {
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.5rem;
        line-height: 1.3;
      }

      .event-desc {
        font-size: 0.83rem;
        color: #64748b;
        line-height: 1.6;
        flex: 1;
        margin-bottom: 1.2rem;
      }

      .btn-event {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--up-blue);
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.5rem 1.1rem;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s;
        align-self: flex-start;
      }

      .btn-event:hover { background: var(--up-gold); }

      /* ======================================
         SECCION: CTA FINAL
         ====================================== */
      .cta-final-section {
        position: relative;
        background: var(--up-blue);
        padding: 6rem 1rem;
        text-align: center;
        overflow: hidden;
      }

      .cta-final-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 20% 50%, rgba(196,154,26,0.15) 0%, transparent 55%),
          radial-gradient(circle at 80% 50%, rgba(0,74,159,0.3) 0%, transparent 55%);
      }

      .cta-final-content { position: relative; z-index: 1; max-width: 680px; margin: 0 auto; }

      .cta-final-title {
        font-family: 'Sora', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #fff;
        margin: 0 0 1rem;
        line-height: 1.15;
      }

      .cta-final-accent { color: var(--up-gold-light); }

      .cta-final-desc {
        color: rgba(255,255,255,0.72);
        font-size: 1rem;
        line-height: 1.7;
        margin: 0 0 2.5rem;
      }

      .cta-final-btns {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn-cta-primary {
        background: var(--up-gold);
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        padding: 0.85rem 2.2rem;
        border-radius: 50px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 4px 20px rgba(196,154,26,0.4);
      }

      .btn-cta-primary:hover { background: var(--up-gold-light); transform: translateY(-2px); }

      .btn-cta-outline {
        background: transparent;
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        padding: 0.85rem 2.2rem;
        border-radius: 50px;
        border: 2px solid rgba(255,255,255,0.35);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: border-color 0.2s, background 0.2s;
      }

      .btn-cta-outline:hover { border-color: #fff; background: rgba(255,255,255,0.07); }

      /* ======================================
         FOOTER MEJORADO
         ====================================== */
      .footer-main {
        background: var(--up-blue-dark);
        padding: 4rem 1rem 0;
      }

      .footer-brand-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: 0.04em;
      }

      .footer-brand-desc {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.5);
        line-height: 1.7;
        margin-top: 0.8rem;
      }

      .footer-social {
        display: flex;
        gap: 10px;
        margin-top: 1.2rem;
      }

      .footer-social-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.6);
        transition: background 0.2s, color 0.2s;
      }

      .footer-social-btn:hover { background: var(--up-gold); color: #fff; border-color: transparent; }

      .footer-col-title {
        font-family: 'Sora', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--up-gold-light);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(196,154,26,0.25);
      }

      .footer-link {
        display: block;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        margin-bottom: 0.65rem;
        transition: color 0.2s;
      }

      .footer-link:hover { color: var(--up-gold-light); }

      .footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        margin-top: 3rem;
        padding: 1.2rem 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
      }

      .footer-bottom-text {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.35);
      }

      /* ======================================
         MOBILE MENU
         ====================================== */
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--up-blue);
        padding: 4px;
      }

      @media (max-width: 768px) {
        .mobile-menu-btn { display: flex; }
        .nav-desktop { display: none !important; }
        .nav-desktop.open { display: flex !important; flex-direction: column; position: absolute; top: 100%; left: 0; right: 0; background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid #e2e8f0; padding: 1rem 1.5rem; gap: 0.8rem; box-shadow: 0 8px 20px rgba(0,0,0,0.1); z-index: 99; }
        .hero-stats-bar { display: none; }
        .step-connector { display: none; }
        .metric-divider { display: none; }
        .hero-stat-bar-divider { display: none; }
        .hero-new-title { font-size: 2.4rem; }
        .hero-new-content { padding: 4rem 1.5rem 5rem; }
        .search-box-glass { max-width: 100%; }
        .jobs-grid { grid-template-columns: 1fr !important; }
        .events-grid { grid-template-columns: 1fr !important; }
        .testimonials-grid { grid-template-columns: 1fr !important; }
        .how-grid { grid-template-columns: 1fr !important; }
        .cta-final-btns { flex-direction: column; align-items: center; }
      }

