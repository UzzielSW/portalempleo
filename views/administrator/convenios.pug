  //- MODAL: CONFIRMACION DE DECISION
  #modal-confirm.modal-overlay
    .modal
      .modal-header#confirm-header
        .modal-title Confirmar Decision
        button.modal-close(onclick='document.getElementById("modal-confirm").classList.remove("open");document.body.style.overflow=""')
          span.material-symbols-outlined close
      .modal-body
        div(id='confirm-body' style='font-size:0.88rem;color:#334155;line-height:1.7')
          | Esta accion sera registrada en el log de auditoria y notificara a la empresa por correo electronico.
      .modal-footer
        button.btn-secondary(onclick='document.getElementById("modal-confirm").classList.remove("open");document.body.style.overflow=""') Cancelar
        button.btn-primary#confirm-action-btn Confirmar

  script.
    function setTab(el) {
      document.querySelectorAll('.ftab').forEach(function(t){ t.classList.remove('active'); });
      el.classList.add('active');
    }
    function selectCard(el) {
      document.querySelectorAll('.sol-card').forEach(function(c){ c.classList.remove('selected'); });
      el.classList.add('selected');
    }
    function switchDTab(tab) {
      document.querySelectorAll('.dtab').forEach(function(t){ t.classList.remove('active'); });
      document.querySelectorAll('.dpanel').forEach(function(p){ p.classList.remove('active'); });
      document.getElementById('dtab-' + tab).classList.add('active');
      document.getElementById('dpanel-' + tab).classList.add('active');
    }
    function showConfirm(type) {
      var titles = { aprobar:'Aprobar Convenio', devolver:'Devolver con Observaciones', rechazar:'Rechazar Solicitud' };
      var msgs = {
        aprobar:'Se aprobara el convenio de <strong>Global Logistics Corp</strong> y se notificara a la empresa por correo. El convenio quedara activo en el sistema.',
        devolver:'Se devolvera la solicitud de <strong>Global Logistics Corp</strong> con las observaciones indicadas para que corrijan los documentos.',
        rechazar:'Se rechazara la solicitud de <strong>Global Logistics Corp</strong>. Esta accion es irreversible y se notificara a la empresa con los motivos.'
      };
      var colors = { aprobar:'var(--up-blue)', devolver:'#a16207', rechazar:'#dc2626' };
      document.getElementById('confirm-header').style.background = 'linear-gradient(135deg,' + colors[type] + ',' + colors[type] + 'cc)';
      document.getElementById('confirm-header').querySelector('.modal-title').textContent = titles[type];
      document.getElementById('confirm-body').innerHTML = msgs[type];
      document.getElementById('confirm-action-btn').textContent = titles[type];
      document.getElementById('confirm-action-btn').style.background = colors[type];
      document.getElementById('modal-confirm').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    document.querySelectorAll('.modal-overlay').forEach(function(o){
      o.addEventListener('click', function(e){
        if(e.target === this){ this.classList.remove('open'); document.body.style.overflow=''; }
      });
    });
