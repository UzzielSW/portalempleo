          span.material-symbols-outlined close
      .modal-body
        .modal-label Nombre completo
        input.modal-input(type='text' placeholder='Nombre y apellidos')
        .modal-label Correo electronico
        input.modal-input(type='email' placeholder='usuario@up.ac.pa')
        .modal-label Cedula de identidad
        input.modal-input(type='text' placeholder='Ej. 8-000-0000')
        .modal-label Rol en el sistema
        select.modal-select
          option Candidato
          option Empleador
          option Administrador
        .modal-label Contrasena temporal
        input.modal-input(type='password' placeholder='Minimo 8 caracteres')
      .modal-footer
        button.btn-secondary(onclick='closeModal("nuevo-usuario")') Cancelar
        button.btn-primary Crear Usuario

  script.
    function showView(view, el) {
      document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
      document.getElementById('view-' + view).classList.add('active');
      document.querySelectorAll('.topbar-nav a').forEach(function(a){ a.classList.remove('active'); });
      if(el) el.classList.add('active');
      window.scrollTo({top:0,behavior:'smooth'});
    }
    function openModal(id) {
      var m = document.getElementById('modal-' + id);
      if(m){ m.classList.add('open'); document.body.style.overflow='hidden'; }
    }
    function closeModal(id) {
      var m = document.getElementById('modal-' + id);
      if(m){ m.classList.remove('open'); document.body.style.overflow=''; }
    }
    // Close on overlay click
    document.querySelectorAll('.modal-overlay').forEach(function(o){
      o.addEventListener('click', function(e){
        if(e.target === this){ this.classList.remove('open'); document.body.style.overflow=''; }
      });
    });
    function applyR(){
      var w = window.innerWidth;
      var g5 = document.querySelector('#view-dashboard .kpi-grid');
      if(g5) g5.style.gridTemplateColumns = w<768 ? 'repeat(2,1fr)' : w<1100 ? 'repeat(3,1fr)' : 'repeat(5,1fr)';
      var g4 = document.querySelectorAll('.kpi-grid:not(#view-dashboard .kpi-grid)');
      g4.forEach(function(g){ g.style.gridTemplateColumns = w<768 ? 'repeat(2,1fr)' : 'repeat(4,1fr)'; });
    }
    applyR();
    window.addEventListener('resize', applyR);
