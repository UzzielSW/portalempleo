doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Panel de Administracion - Portal de Empleo UP
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")
    style.
      :root{--up-blue:#003876;--up-blue-dark:#002147;--up-gold:#C49A1A;--up-gold-light:#e8c44d;--bg:#f0f4f8;}
      *{box-sizing:border-box;margin:0;padding:0;}
      body{font-family:'DM Sans',sans-serif;background:var(--bg);color:#1a2233;min-height:100vh;display:flex;flex-direction:column;}
      h1,h2,h3,h4{font-family:'Sora',sans-serif;}
      .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;}
      a{text-decoration:none;}

      /* ===== TOPBAR ===== */
      .topbar{background:var(--up-blue-dark);color:#fff;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 20px rgba(0,20,60,0.25);}
      .topbar-inner{max-width:1400px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem;}
      .topbar-brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0;}
      .topbar-brand-icon{background:var(--up-gold);border-radius:9px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:var(--up-blue-dark);flex-shrink:0;}
      .topbar-brand-name{font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;line-height:1.1;}
      .topbar-brand-sub{font-size:0.58rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--up-gold-light);}
      .admin-badge{display:inline-flex;align-items:center;gap:4px;background:rgba(196,154,26,0.15);border:1px solid rgba(196,154,26,0.35);color:var(--up-gold-light);font-size:0.58rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;padding:2px 8px;border-radius:50px;margin-left:6px;flex-shrink:0;}
      .admin-badge .material-symbols-outlined{font-size:0.72rem;font-variation-settings:'FILL' 1;}
      .topbar-nav{display:flex;align-items:center;height:100%;gap:2px;}
      .topbar-nav a{display:flex;align-items:center;gap:6px;height:100%;padding:0 14px;font-family:'Sora',sans-serif;font-size:0.8rem;font-weight:700;color:rgba(255,255,255,0.55);text-decoration:none;border-bottom:3px solid transparent;transition:color 0.2s,border-color 0.2s;white-space:nowrap;}
      .topbar-nav a .material-symbols-outlined{font-size:0.95rem;font-variation-settings:'FILL' 1;}
      .topbar-nav a:hover{color:#fff;}
      .topbar-nav a.active{color:#fff;border-bottom-color:var(--up-gold);}
      .topbar-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
      .topbar-icon-btn{background:rgba(255,255,255,0.07);border:none;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.6);cursor:pointer;transition:background 0.2s;position:relative;}
      .topbar-icon-btn:hover{background:rgba(255,255,255,0.14);color:#fff;}
      .notif-dot{position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--up-gold);border:2px solid var(--up-blue-dark);}
      .topbar-divider{width:1px;height:28px;background:rgba(255,255,255,0.1);margin:0 4px;}
      .topbar-user{display:flex;align-items:center;gap:9px;cursor:pointer;padding:4px 8px;border-radius:10px;transition:background 0.2s;}
      .topbar-user:hover{background:rgba(255,255,255,0.07);}
      .topbar-user-name{font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#fff;line-height:1.15;text-align:right;}
      .topbar-user-sub{font-size:0.58rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--up-gold-light);text-align:right;}
      .topbar-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--up-blue),var(--up-blue-dark));display:flex;align-items:center;justify-content:center;color:var(--up-gold-light);font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;flex-shrink:0;border:2px solid rgba(196,154,26,0.35);}

      /* ===== VIEWS ===== */
      .view{display:none;}
      .view.active{display:block;}

      /* ===== MAIN ===== */
      .main-content{flex:1;max-width:1400px;margin:0 auto;width:100%;padding:2rem 1.5rem 4rem;}
      .page-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.8rem;}
      .page-title{font-family:'Sora',sans-serif;font-size:1.6rem;font-weight:800;color:#0f172a;}
      .page-subtitle{font-size:0.88rem;color:#64748b;margin-top:3px;}
      .header-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}

      /* ===== BUTTONS ===== */
      .btn-primary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 18px;border-radius:10px;background:var(--up-blue);color:#fff;border:none;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;cursor:pointer;transition:all 0.2s;box-shadow:0 3px 10px rgba(0,56,118,0.2);}
      .btn-primary:hover{background:var(--up-gold);}
      .btn-primary .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .btn-gold{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 18px;border-radius:10px;background:var(--up-gold);color:#fff;border:none;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;cursor:pointer;transition:all 0.2s;box-shadow:0 3px 10px rgba(196,154,26,0.25);}
      .btn-gold:hover{background:var(--up-gold-light);color:var(--up-blue);}
      .btn-gold .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .btn-secondary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#334155;cursor:pointer;transition:all 0.2s;}
      .btn-secondary:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .btn-secondary .material-symbols-outlined{font-size:1rem;}
      .date-range{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#334155;cursor:pointer;}
      .date-range .material-symbols-outlined{font-size:0.95rem;color:var(--up-blue);font-variation-settings:'FILL' 1;}

      /* ===== STATS ===== */
      .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:1.8rem;}
      .kpi-card{background:#fff;border-radius:16px;border:1.5px solid #e8edf5;padding:1.3rem 1.5rem;box-shadow:0 2px 10px rgba(0,56,118,0.04);position:relative;overflow:hidden;}
      .kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0;}
      .kpi-blue::before{background:linear-gradient(to right,var(--up-blue),#1e60c8);}
      .kpi-gold::before{background:linear-gradient(to right,var(--up-gold),var(--up-gold-light));}
      .kpi-green::before{background:linear-gradient(to right,#16a34a,#22c55e);}
      .kpi-red::before{background:linear-gradient(to right,#dc2626,#f87171);}
      .kpi-purple::before{background:linear-gradient(to right,#7c3aed,#a78bfa);}
      .kpi-label{font-size:0.65rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#94a3b8;margin-bottom:0.7rem;display:flex;align-items:center;gap:6px;}
      .kpi-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
      .kpi-icon .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;}
      .kpi-icon-blue{background:#eff6ff;color:var(--up-blue);}
      .kpi-icon-gold{background:#fefce8;color:#a16207;}
      .kpi-icon-green{background:#f0fdf4;color:#16a34a;}
      .kpi-icon-red{background:#fef2f2;color:#dc2626;}
      .kpi-icon-purple{background:#faf5ff;color:#7c3aed;}
      .kpi-value{font-family:'Sora',sans-serif;font-size:2rem;font-weight:800;color:#0f172a;line-height:1;margin-bottom:6px;}
      .kpi-trend{display:flex;align-items:center;gap:4px;font-size:0.75rem;font-weight:700;}
      .trend-up{color:#16a34a;}
      .trend-down{color:#dc2626;}
      .trend-neutral{color:#94a3b8;}
      .trend-up .material-symbols-outlined,.trend-down .material-symbols-outlined,.trend-neutral .material-symbols-outlined{font-size:0.85rem;}

      /* ===== CHARTS GRID ===== */
      .charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-bottom:1.8rem;}
      .chart-card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;padding:1.5rem;box-shadow:0 2px 12px rgba(0,56,118,0.05);}
      .chart-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.4rem;}
      .chart-title{font-family:'Sora',sans-serif;font-size:0.92rem;font-weight:800;color:#0f172a;}
      .chart-legend{display:flex;align-items:center;gap:6px;font-size:0.72rem;color:#64748b;font-weight:600;}
      .legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
      .chart-area{height:190px;position:relative;}

      /* SVG Charts */
      .chart-svg{width:100%;height:100%;}
      .chart-labels{display:flex;justify-content:space-between;padding:0 8px;margin-top:8px;}
      .chart-label{font-size:0.65rem;color:#94a3b8;font-weight:600;}

      /* ===== 3-COL BOTTOM ===== */
      .bottom-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:1.4rem;margin-bottom:1.8rem;}

      /* Industry table */
      .industry-table{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;overflow:hidden;box-shadow:0 2px 12px rgba(0,56,118,0.05);}
      .it-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.5rem;border-bottom:1px solid #f1f5f9;}
      .it-title{font-family:'Sora',sans-serif;font-size:0.92rem;font-weight:800;color:#0f172a;}
      .it-updated{font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#94a3b8;display:flex;align-items:center;gap:4px;}
      .it-updated .material-symbols-outlined{font-size:0.75rem;color:#22c55e;font-variation-settings:'FILL' 1;}
      .it-col-headers{display:grid;grid-template-columns:1.8fr 1fr 1fr 1.2fr;gap:0;padding:0.6rem 1.5rem;background:#f8fafc;border-bottom:1px solid #f1f5f9;}
      .it-col-h{font-size:0.62rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#94a3b8;}
      .it-row{display:grid;grid-template-columns:1.8fr 1fr 1fr 1.2fr;align-items:center;padding:0.9rem 1.5rem;border-bottom:1px solid #f8fafc;transition:background 0.15s;}
      .it-row:last-child{border-bottom:none;}
      .it-row:hover{background:#fafbfc;}
      .it-industry{display:flex;align-items:center;gap:9px;}
      .it-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
      .it-icon .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .it-name{font-family:'Sora',sans-serif;font-size:0.85rem;font-weight:700;color:#0f172a;}
      .it-count{font-size:0.85rem;font-weight:600;color:#334155;}
      .it-salary{font-size:0.83rem;font-weight:600;color:#334155;}
      .it-retention{display:flex;align-items:center;gap:8px;}
      .ret-bar-bg{height:5px;background:#f1f5f9;border-radius:3px;overflow:hidden;flex:1;}
      .ret-bar{height:5px;border-radius:3px;}
      .ret-pct{font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;color:#0f172a;flex-shrink:0;min-width:28px;text-align:right;}

      /* Activity feed */
      .activity-card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;overflow:hidden;box-shadow:0 2px 12px rgba(0,56,118,0.05);}
      .ac-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.5rem;border-bottom:1px solid #f1f5f9;}
      .ac-title{font-family:'Sora',sans-serif;font-size:0.92rem;font-weight:800;color:#0f172a;}
      .ac-body{padding:0.8rem 1.5rem;}
      .ac-item{display:flex;gap:10px;align-items:flex-start;padding:0.75rem 0;border-bottom:1px solid #f8fafc;position:relative;}
      .ac-item:last-child{border-bottom:none;}
      .ac-icon{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
      .ac-icon .material-symbols-outlined{font-size:0.85rem;font-variation-settings:'FILL' 1;}
      .ai-blue{background:#eff6ff;color:var(--up-blue);}
      .ai-gold{background:#fefce8;color:#a16207;}
      .ai-green{background:#f0fdf4;color:#16a34a;}
      .ai-red{background:#fef2f2;color:#dc2626;}
      .ai-purple{background:#faf5ff;color:#7c3aed;}
      .ac-text{font-size:0.8rem;color:#334155;line-height:1.5;flex:1;}
      .ac-text strong{font-family:'Sora',sans-serif;font-weight:700;color:#0f172a;}
      .ac-time{font-size:0.68rem;color:#94a3b8;font-weight:600;margin-top:2px;}

      /* ===== TOP EMPLOYERS ROW ===== */
      .top-row{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-bottom:1.8rem;}
      .ranking-card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;overflow:hidden;box-shadow:0 2px 12px rgba(0,56,118,0.05);}
      .rc-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.5rem;border-bottom:1px solid #f1f5f9;}
      .rc-title{font-family:'Sora',sans-serif;font-size:0.92rem;font-weight:800;color:#0f172a;}
      .rc-body{padding:0.5rem 0;}
      .rc-row{display:flex;align-items:center;gap:10px;padding:0.75rem 1.5rem;border-bottom:1px solid #f8fafc;transition:background 0.15s;}
      .rc-row:last-child{border-bottom:none;}
      .rc-row:hover{background:#fafbfc;}
      .rc-rank{font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;color:#94a3b8;width:20px;flex-shrink:0;}
      .rc-rank.top1{color:var(--up-gold);}
      .rc-rank.top2{color:#94a3b8;}
      .rc-rank.top3{color:#cd7f32;}
      .rc-logo{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:800;color:#fff;flex-shrink:0;}
      .rc-info{flex:1;min-width:0;}
      .rc-name{font-family:'Sora',sans-serif;font-size:0.83rem;font-weight:700;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
      .rc-meta{font-size:0.7rem;color:#94a3b8;margin-top:1px;}
      .rc-value{font-family:'Sora',sans-serif;font-size:0.85rem;font-weight:800;color:var(--up-blue);flex-shrink:0;}

      /* ===== FILTER BAR ===== */
      .filter-bar{background:#fff;border-radius:16px;border:1.5px solid #e8edf5;padding:1rem 1.4rem;display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:1.2rem;}
      .filter-search{display:flex;align-items:center;gap:8px;flex:1;min-width:200px;background:#f8fafc;border:1.5px solid #f1f5f9;border-radius:10px;padding:0 12px;height:40px;transition:border-color 0.2s;}
      .filter-search:focus-within{border-color:var(--up-blue);background:#fff;}
      .filter-search .material-symbols-outlined{font-size:1rem;color:#94a3b8;}
      .filter-search input{background:none;border:none;outline:none;font-family:'DM Sans',sans-serif;font-size:0.85rem;color:#334155;width:100%;}
      .filter-search input::placeholder{color:#b0bec5;}
      .fsel-wrap{position:relative;}
      .fsel-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:0.95rem;color:#64748b;pointer-events:none;font-variation-settings:'FILL' 1;}
      .fsel{height:40px;padding:0 30px 0 32px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'DM Sans',sans-serif;font-size:0.83rem;font-weight:600;color:#334155;cursor:pointer;outline:none;appearance:none;}
      .fsel:focus{border-color:var(--up-blue);}
      .fchev{position:absolute;right:9px;top:50%;transform:translateY(-50%);font-size:0.85rem;color:#94a3b8;pointer-events:none;}

      /* ===== TABLE SHARED ===== */
      .table-card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;box-shadow:0 2px 12px rgba(0,56,118,0.05);overflow:hidden;}
      .table-footer{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.4rem;border-top:1px solid #f1f5f9;flex-wrap:wrap;gap:0.8rem;}
      .tf-info{font-size:0.78rem;color:#94a3b8;}
      .tf-pages{display:flex;align-items:center;gap:6px;}
      .page-btn{width:32px;height:32px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#334155;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;}
      .page-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .page-btn.active{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .page-btn:disabled{color:#cbd5e1;cursor:not-allowed;}
      .th{font-size:0.65rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#94a3b8;}
      .row-actions{display:flex;align-items:center;gap:4px;justify-content:flex-end;}
      .act-btn{height:30px;padding:0 10px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;display:inline-flex;align-items:center;gap:4px;color:#64748b;cursor:pointer;transition:all 0.2s;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:700;}
      .act-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .act-btn.primary{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .act-btn.danger:hover{border-color:#ef4444;color:#ef4444;}
      .act-btn.success:hover{border-color:#22c55e;color:#22c55e;}
      .act-btn .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;}
      .act-icon-btn{width:30px;height:30px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;display:flex;align-items:center;justify-content:center;color:#64748b;cursor:pointer;transition:all 0.2s;}
      .act-icon-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .act-icon-btn.danger:hover{border-color:#ef4444;color:#ef4444;}
      .act-icon-btn .material-symbols-outlined{font-size:0.95rem;}

      /* STATUS BADGES */
      .sbadge{display:inline-flex;align-items:center;gap:5px;font-size:0.68rem;font-weight:700;padding:4px 10px;border-radius:50px;}
      .sdot{width:5px;height:5px;border-radius:50%;flex-shrink:0;}
      .sb-active{background:#f0fdf4;color:#15803d;}.sb-active .sdot{background:#22c55e;animation:pulse 2s infinite;}
      .sb-pending{background:#fefce8;color:#92400e;}.sb-pending .sdot{background:#f59e0b;animation:pulse 2s infinite;}
      .sb-expired{background:#fef2f2;color:#dc2626;}.sb-expired .sdot{background:#ef4444;}
      .sb-suspended{background:#f1f5f9;color:#475569;}.sb-suspended .sdot{background:#94a3b8;}
      .sb-review{background:#eff6ff;color:#1e40af;}.sb-review .sdot{background:#3b82f6;animation:pulse 2s infinite;}
      .sb-blocked{background:#fef2f2;color:#dc2626;}.sb-blocked .sdot{background:#ef4444;}
      .sb-candidate{background:#eff6ff;color:var(--up-blue);}
      .sb-employer{background:#faf5ff;color:#6d28d9;}
      .sb-admin{background:#fefce8;color:#a16207;}
      @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}

      /* STATUS TABS */
      .stabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:1.2rem;}
      .stab{display:inline-flex;align-items:center;gap:5px;height:32px;padding:0 12px;border-radius:50px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:700;color:#64748b;cursor:pointer;transition:all 0.2s;}
      .stab:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .stab.active{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .stab-count{font-size:0.65rem;font-weight:800;padding:1px 6px;border-radius:50px;}
      .stab.active .stab-count{background:rgba(255,255,255,0.2);}
      .stab:not(.active) .stab-count{background:#f1f5f9;color:#64748b;}

      /* ===== CONVENIOS ===== */
      .conv-table-head{display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr 1fr 1.2fr;align-items:center;padding:0.8rem 1.4rem;background:#f8fafc;border-bottom:1px solid #f1f5f9;}
      .conv-row{display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr 1fr 1.2fr;align-items:center;padding:0.95rem 1.4rem;border-bottom:1px solid #f8fafc;transition:background 0.15s;cursor:pointer;}
      .conv-row:last-child{border-bottom:none;}
      .conv-row:hover{background:#fafbfc;}
      .conv-company{display:flex;align-items:center;gap:9px;}
      .conv-logo{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:800;color:#fff;flex-shrink:0;}
      .conv-name{font-family:'Sora',sans-serif;font-size:0.87rem;font-weight:700;color:#0f172a;}
      .conv-ruc{font-size:0.7rem;color:#94a3b8;margin-top:1px;}
      .conv-type{font-size:0.8rem;color:#334155;font-weight:500;}
      .conv-date{font-size:0.82rem;color:#64748b;}
      .conv-days-left{font-size:0.7rem;margin-top:1px;font-weight:700;}
      .days-ok{color:#16a34a;}
      .days-warn{color:#f59e0b;}
      .days-crit{color:#dc2626;}
      .conv-progress{display:flex;flex-direction:column;gap:3px;}
      .cp-bar-bg{height:4px;background:#f1f5f9;border-radius:2px;overflow:hidden;width:80px;}
      .cp-bar{height:4px;border-radius:2px;}
      .bar-green{background:#22c55e;}
      .bar-gold{background:var(--up-gold);}
      .bar-red{background:#ef4444;}
      .cp-pct{font-size:0.65rem;color:#94a3b8;}
      .conv-vacantes{font-family:'Sora',sans-serif;font-size:0.88rem;font-weight:700;color:var(--up-blue);}

      /* Timeline renewal */
      .renew-bar{height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;margin-bottom:4px;}
      .renew-fill{height:6px;border-radius:3px;}

      /* ===== USUARIOS ===== */
      .usr-table-head{display:grid;grid-template-columns:2.2fr 1.2fr 1fr 1fr 1fr 1.1fr;align-items:center;padding:0.8rem 1.4rem;background:#f8fafc;border-bottom:1px solid #f1f5f9;}
      .usr-row{display:grid;grid-template-columns:2.2fr 1.2fr 1fr 1fr 1fr 1.1fr;align-items:center;padding:0.9rem 1.4rem;border-bottom:1px solid #f8fafc;transition:background 0.15s;cursor:pointer;}
      .usr-row:last-child{border-bottom:none;}
      .usr-row:hover{background:#fafbfc;}
      .usr-identity{display:flex;align-items:center;gap:10px;}
      .usr-avatar{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:800;flex-shrink:0;}
      .usr-name{font-family:'Sora',sans-serif;font-size:0.87rem;font-weight:700;color:#0f172a;}
      .usr-email{font-size:0.72rem;color:#94a3b8;margin-top:1px;}
      .usr-role-pill{display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;font-weight:700;padding:3px 9px;border-radius:50px;letter-spacing:0.04em;text-transform:uppercase;}
      .urp-candidate{background:#eff6ff;color:var(--up-blue);}
      .urp-employer{background:#faf5ff;color:#6d28d9;}
      .urp-admin{background:#fefce8;color:#a16207;}
      .usr-date{font-size:0.82rem;color:#64748b;}
      .usr-date-sub{font-size:0.7rem;color:#94a3b8;margin-top:1px;}
      .usr-activity{font-size:0.78rem;color:#64748b;}
      .usr-activity-sub{font-size:0.7rem;color:#94a3b8;margin-top:1px;}

      /* ===== MODAL ===== */
      .modal-overlay{position:fixed;inset:0;background:rgba(0,20,50,0.55);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center;}
      .modal-overlay.open{display:flex;}
      .modal{background:#fff;border-radius:20px;width:500px;max-width:95vw;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,20,60,0.2);}
      .modal-header{background:linear-gradient(135deg,var(--up-blue),var(--up-blue-dark));padding:1.4rem 1.6rem;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
      .modal-title{font-family:'Sora',sans-serif;font-size:0.95rem;font-weight:800;color:#fff;}
      .modal-close{background:rgba(255,255,255,0.12);border:none;border-radius:8px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;}
      .modal-close:hover{background:rgba(255,255,255,0.2);}
      .modal-close .material-symbols-outlined{font-size:1rem;}
      .modal-body{padding:1.5rem 1.6rem;overflow-y:auto;flex:1;}
      .modal-footer{padding:1rem 1.6rem;border-top:1px solid #f1f5f9;display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;}
      .modal-label{font-size:0.65rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#94a3b8;margin-bottom:4px;margin-top:1rem;}
      .modal-label:first-child{margin-top:0;}
      .modal-value{font-size:0.88rem;font-weight:600;color:#334155;}
      .modal-input{width:100%;height:40px;border:1.5px solid #e2e8f0;border-radius:10px;padding:0 12px;font-family:'DM Sans',sans-serif;font-size:0.88rem;color:#334155;outline:none;transition:border-color 0.2s;}
      .modal-input:focus{border-color:var(--up-blue);}
      .modal-select{width:100%;height:40px;border:1.5px solid #e2e8f0;border-radius:10px;padding:0 12px;font-family:'DM Sans',sans-serif;font-size:0.88rem;color:#334155;outline:none;appearance:none;background:#fff;}
      .modal-select:focus{border-color:var(--up-blue);}
      .modal-textarea{width:100%;border:1.5px solid #e2e8f0;border-radius:10px;padding:10px 12px;font-family:'DM Sans',sans-serif;font-size:0.88rem;color:#334155;outline:none;resize:vertical;min-height:80px;line-height:1.65;}
      .modal-textarea:focus{border-color:var(--up-blue);}

      /* ===== FOOTER ===== */
      .footer-strip{background:var(--up-blue-dark);border-top:1px solid rgba(255,255,255,0.06);padding:1.2rem 1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.5rem;}
      .footer-brand{display:flex;align-items:center;gap:6px;color:rgba(255,255,255);font-size:0.72rem;}
      .footer-center{font-size:0.72rem;color:rgba(255,255,255);letter-spacing:0.06em;text-transform:uppercase;}
      .footer-links{display:flex;gap:1rem;}
      .footer-links a{color:rgba(255,255,255);text-decoration:none;font-size:0.72rem;transition:color 0.2s;}
      .footer-links a:hover{color:rgba(255,255,255,0.7);}

      /* ===== RESPONSIVE ===== */
      @media(max-width:1100px){
        .kpi-grid{grid-template-columns:repeat(2,1fr);}
        .charts-grid{grid-template-columns:1fr;}
        .bottom-grid{grid-template-columns:1fr;}
        .top-row{grid-template-columns:1fr;}
        .conv-table-head,.conv-row{grid-template-columns:2fr 1.2fr 1fr 1.2fr;}
        .conv-table-head>*:nth-child(3),.conv-table-head>*:nth-child(4),.conv-row>*:nth-child(3),.conv-row>*:nth-child(4){display:none;}
        .usr-table-head,.usr-row{grid-template-columns:2fr 1.2fr 1fr 1.1fr;}
        .usr-table-head>*:nth-child(4),.usr-table-head>*:nth-child(5),.usr-row>*:nth-child(4),.usr-row>*:nth-child(5){display:none;}
      }
      @media(max-width:768px){.topbar-nav a span:not(.material-symbols-outlined){display:none;}.kpi-grid{grid-template-columns:1fr 1fr;}}
      @media(max-width:480px){.kpi-grid{grid-template-columns:1fr 1fr;}}

