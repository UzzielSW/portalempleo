include ./components/head
include ./components/navbar
include ./components/footer-strip
include ./components/menu-script

doctype html
html(lang='es')
  head
    +publicHead('Requisitos de Registro - Portal de Empleo UP')

    style.
      /* ---- HERO BANNER ---- */
      .req-hero {
        background: linear-gradient(135deg, var(--up-blue) 0%, var(--up-blue-dark) 60%, #001530 100%);
        padding: 4rem 1.5rem;
        position: relative;
        overflow: hidden;
      }

      .req-hero::before {
        content: '';
        position: absolute; top: -80px; right: -80px;
        width: 320px; height: 320px; border-radius: 50%;
        background: rgba(255,255,255,0.04); pointer-events: none;
      }

      .req-hero::after {
        content: '';
        position: absolute; bottom: -60px; left: 10%;
        width: 260px; height: 260px; border-radius: 50%;
        background: rgba(196,154,26,0.07); pointer-events: none;
      }

      .req-hero-inner {
        max-width: 1280px; margin: 0 auto;
        position: relative; z-index: 1;
      }

      .req-hero-badge {
        display: inline-flex; align-items: center; gap: 7px;
        background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18);
        color: var(--up-gold-light); font-size: 0.68rem; font-weight: 700;
        letter-spacing: 0.18em; text-transform: uppercase;
        padding: 5px 14px; border-radius: 50px; margin-bottom: 1.2rem;
      }

      .req-hero-badge-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--up-gold-light);
      }

      .req-hero-title {
        font-family: 'Sora', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800; color: #fff; margin-bottom: 1rem; line-height: 1.15;
      }

      .req-hero-desc {
        font-size: 1rem; color: rgba(255,255,255,0.65);
        max-width: 560px; line-height: 1.75; margin-bottom: 2rem;
      }

      .req-hero-stats {
        display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2.5rem;
      }

      .req-hero-stat {
        display: flex; align-items: center; gap: 10px;
      }

      .req-hero-stat-icon {
        width: 40px; height: 40px; border-radius: 10px;
        background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        color: var(--up-gold-light);
      }

      .req-hero-stat-num {
        font-family: 'Sora', sans-serif; font-size: 1.2rem; font-weight: 800; color: #fff;
      }

      .req-hero-stat-label {
        font-size: 0.72rem; color: rgba(255,255,255,0.5); letter-spacing: 0.04em;
      }

      /* ---- CTA BAND ---- */
      .cta-band {
        background: #fff;
        border-bottom: 1px solid #e8edf5;
      }

      .cta-band-inner {
        max-width: 1280px; margin: 0 auto; padding: 1.8rem 1.5rem;
        display: flex; flex-wrap: wrap; align-items: center;
        justify-content: space-between; gap: 1.5rem;
      }

      .cta-band-text h2 {
        font-family: 'Sora', sans-serif; font-size: 1.2rem;
        font-weight: 800; color: #0f172a; margin-bottom: 0.3rem;
      }

      .cta-band-text p {
        font-size: 0.88rem; color: #64748b;
      }

      .btn-cta-primary {
        display: inline-flex; align-items: center; gap: 8px;
        background: var(--up-gold); color: #fff;
        font-family: 'Sora', sans-serif; font-size: 0.9rem; font-weight: 700;
        padding: 0.75rem 1.8rem; border-radius: 12px; text-decoration: none;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 4px 16px rgba(196,154,26,0.3);
        white-space: nowrap;
      }

      .btn-cta-primary:hover { background: #a07a10; transform: translateY(-1px); }

      /* ---- MAIN CONTENT ---- */
      main {
        flex: 1;
        padding: 3rem 1.5rem 5rem;
      }

      .content-wrap {
        max-width: 1000px; margin: 0 auto;
        display: flex; flex-direction: column; gap: 3.5rem;
      }

      /* ---- SECTION HEADER ---- */
      .section-header {
        display: flex; align-items: center; gap: 14px; margin-bottom: 2rem;
      }

      .section-header-icon {
        width: 46px; height: 46px; border-radius: 12px;
        flex-shrink: 0;
      }

      .section-header-icon .material-symbols-outlined {
        font-size: 1.3rem; font-variation-settings: 'FILL' 1;
      }

      .section-title {
        font-family: 'Sora', sans-serif; font-size: 1.4rem;
        font-weight: 800; color: #0f172a;
      }

      .section-subtitle {
        font-size: 0.82rem; color: #64748b; margin-top: 2px;
      }

      /* ---- TIMELINE ---- */
      .timeline { position: relative; }

      .timeline-item {
        display: flex; gap: 1.5rem;
        position: relative; padding-bottom: 2.5rem;
      }

      .timeline-item:last-child { padding-bottom: 0; }

      .timeline-left {
        display: flex; flex-direction: column; align-items: center;
        flex-shrink: 0; width: 48px;
      }

      .timeline-circle {
        width: 48px; height: 48px; border-radius: 50%;
        background: linear-gradient(135deg, var(--up-blue), var(--up-blue-mid));
        display: flex; align-items: center; justify-content: center;
        color: #fff; box-shadow: 0 4px 14px rgba(0,56,118,0.25);
        flex-shrink: 0; position: relative; z-index: 1;
      }

      .timeline-circle .material-symbols-outlined {
        font-size: 1.2rem; font-variation-settings: 'FILL' 1;
      }

      .timeline-line {
        flex: 1; width: 2px; margin-top: 8px;
        background: linear-gradient(to bottom, rgba(0,56,118,0.2), rgba(0,56,118,0.05));
      }

      .timeline-item:last-child .timeline-line { display: none; }

      .timeline-body {
        flex: 1; padding-top: 8px;
      }

      .timeline-step-tag {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em;
        text-transform: uppercase; color: var(--up-gold); margin-bottom: 3px;
      }

      .timeline-step-title {
        font-family: 'Sora', sans-serif; font-size: 1.05rem;
        font-weight: 800; color: var(--up-blue); margin-bottom: 0.5rem;
      }

      .timeline-step-desc {
        font-size: 0.88rem; color: #64748b; line-height: 1.75;
      }

      .timeline-step-card {
        margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 8px;
      }

      .timeline-tag {
        display: inline-flex; align-items: center; gap: 5px;
        background: #f0f4ff; border: 1px solid #dbeafe;
        color: var(--up-blue); font-size: 0.75rem; font-weight: 600;
        padding: 4px 10px; border-radius: 50px;
      }

      .timeline-tag .material-symbols-outlined { font-size: 0.85rem; }

      /* ---- DOCS GRID ---- */
      .docs-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
      }

      .doc-card {
        display: flex; gap: 14px; align-items: flex-start;
        padding: 1.2rem 1.3rem;
        border-radius: 14px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .doc-card:hover {
        border-color: rgba(0,56,118,0.3);
        box-shadow: 0 4px 16px rgba(0,56,118,0.07);
      }

      .doc-card-icon {
        width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
        background: #eff6ff;
        display: flex; align-items: center; justify-content: center;
        color: var(--up-blue);
      }

      .doc-card-icon .material-symbols-outlined {
        font-size: 1.1rem; font-variation-settings: 'FILL' 1;
      }

      .doc-card-title {
        font-family: 'Sora', sans-serif; font-size: 0.88rem;
        font-weight: 700; color: #0f172a; margin-bottom: 3px;
      }

      .doc-card-desc {
        font-size: 0.78rem; color: #64748b; line-height: 1.5;
      }

      .doc-card-required {
        display: inline-flex; align-items: center; gap: 3px;
        margin-top: 6px; font-size: 0.68rem; font-weight: 700;
        color: #b45309; background: #fff7ed; border: 1px solid #fed7aa;
        padding: 2px 8px; border-radius: 50px;
      }

      /* ---- INFO NOTICE ---- */
      .info-notice {
        display: flex; gap: 14px; align-items: flex-start;
        padding: 1.2rem 1.5rem;
        background: #eff6ff; border: 1.5px solid #bfdbfe;
        border-radius: 14px; margin-top: 1.2rem;
      }

      .info-notice-icon {
        color: var(--up-blue); flex-shrink: 0; margin-top: 1px;
      }

      .info-notice-icon .material-symbols-outlined {
        font-variation-settings: 'FILL' 1;
      }

      .info-notice p {
        font-size: 0.85rem; color: #1e3a5f; line-height: 1.7;
      }

      /* ---- FAQ ---- */
      .faq-list { display: flex; flex-direction: column; gap: 10px; }

      .faq-item {
        border-radius: 14px;
        overflow: hidden;
        transition: border-color 0.2s;
      }

      .faq-item:hover { border-color: #bfdbfe; }

      .faq-question {
        width: 100%; display: flex; align-items: center; justify-content: space-between;
        gap: 12px; padding: 1.1rem 1.3rem;
        background: none; border: none; cursor: pointer;
        text-align: left; font-family: 'Sora', sans-serif;
        font-size: 0.9rem; font-weight: 700; color: #0f172a;
        transition: color 0.2s;
      }

      .faq-question:hover { color: var(--up-blue); }

      .faq-chevron {
        color: #94a3b8; flex-shrink: 0; transition: transform 0.25s;
        font-variation-settings: 'FILL' 0;
      }

      .faq-item.open .faq-chevron { transform: rotate(180deg); color: var(--up-blue); }
      .faq-item.open .faq-question { color: var(--up-blue); }

      .faq-answer {
        max-height: 0; overflow: hidden;
        transition: max-height 0.3s ease, padding 0.25s;
        padding: 0 1.3rem;
        font-size: 0.85rem; color: #64748b; line-height: 1.75;
      }

      .faq-item.open .faq-answer {
        max-height: 200px; padding-bottom: 1.2rem;
      }

      /* ---- RESPONSIVE ---- */
      @media (max-width: 768px) {
        .docs-grid { grid-template-columns: 1fr; }
        .req-hero-stats { gap: 1.2rem; }
        .cta-band-inner { flex-direction: column; align-items: flex-start; }
      }

  +publicNavbar({ active: 'requirements' })

  //- ============================================================
  //- HERO BANNER
  //- ============================================================
  .req-hero
    .req-hero-inner
      .req-hero-badge
        .req-hero-badge-dot
        | Convenios Universitarios &mdash; Universidad de Panamá

      h1.req-hero-title
        | Requisitos de Registro
        br
        | para Entidades

      p.req-hero-desc
        | Conecte su organización con el talento académico más preparado del país. Regístrese como entidad aliada del Portal de Empleo UP y publique sus vacantes de forma gratuita.

      .req-hero-stats
        .req-hero-stat
          .req-hero-stat-icon
            span.material-symbols-outlined(style='font-size:1.1rem; font-variation-settings:"FILL" 1') verified
          div
            .req-hero-stat-num 48&ndash;72h
            .req-hero-stat-label Tiempo de aprobación

        .req-hero-stat
          .req-hero-stat-icon
            span.material-symbols-outlined(style='font-size:1.1rem; font-variation-settings:"FILL" 1') groups
          div
            .req-hero-stat-num +15,000
            .req-hero-stat-label Estudiantes disponibles

        .req-hero-stat
          .req-hero-stat-icon
            span.material-symbols-outlined(style='font-size:1.1rem; font-variation-settings:"FILL" 1') work_history
          div
            .req-hero-stat-num Gratuito
            .req-hero-stat-label Publicación de vacantes

  //- ============================================================
  //- CTA BAND
  //- ============================================================
  .cta-band
    .cta-band-inner
      .cta-band-text
        h2 &iquest;Listo para colaborar con la UP?
          p Siga el proceso y acceda al ecosistema de talento universitario más grande de Panamá.
      a.btn-cta-primary(href='/register')
        span.material-symbols-outlined(style='font-size:1.05rem; font-variation-settings:"FILL" 1') rocket_launch
        | Iniciar Registro Ahora

  //- ============================================================
  //- MAIN
  //- ============================================================
  main
    .content-wrap

      //- ---- PROCESO ----
      section
        .section-header
          .section-header-icon.up-gradient-icon
            span.material-symbols-outlined route
          div
            h2.section-title Proceso de Registro
            p.section-subtitle Tres simples pasos para unirse a nuestra red de empresas aliadas

        .timeline

          .timeline-item
            .timeline-left
              .timeline-circle
                span.material-symbols-outlined person_add
              .timeline-line
            .timeline-body
              .timeline-step-tag Paso 01
              h3.timeline-step-title Creacion de Cuenta
              p.timeline-step-desc
                | Complete el formulario de registro con los datos corporativos de su entidad: razón social, RUC, datos del representante legal y correo de contacto institucional. Esta información será la base de su perfil en el portal.
              .timeline-step-card
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') schedule
                  | ~10 minutos
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') devices
                  | Proceso en línea

          .timeline-item
            .timeline-left
              .timeline-circle
                span.material-symbols-outlined cloud_upload
              .timeline-line
            .timeline-body
              .timeline-step-tag Paso 02
              h3.timeline-step-title Carga de Documentos
              p.timeline-step-desc
                | Adjunte la documentación legal requerida para validar la identidad de su organización. Todos los archivos deben estar en formato PDF y no superar los 5MB por documento. Consulte la lista completa más abajo.
              .timeline-step-card
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') picture_as_pdf
                  | Solo formato PDF
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') storage
                  | Max. 5MB por archivo

          .timeline-item
            .timeline-left
              .timeline-circle
                span.material-symbols-outlined verified
            .timeline-body
              .timeline-step-tag Paso 03
              h3.timeline-step-title Revisión y Aprobación del Convenio
              p.timeline-step-desc
                | La Dirección de Vinculación con la Empresa de la Universidad de Panamá revisará los documentos enviados en un plazo de 48 a 72 horas hábiles. Al ser aprobado el convenio, recibirá una notificación al correo registrado confirmando la activación del mismo.
              .timeline-step-card
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') hourglass_empty
                  | 48&ndash;72 horas hábiles
                span.timeline-tag
                  span.material-symbols-outlined(style='font-size:0.9rem') mark_email_read
                  | Notificación por correo

      //- ---- DOCUMENTACION ----
      section
        .section-header
          .section-header-icon.up-gradient-icon
            span.material-symbols-outlined description
          div
            h2.section-title Documentacion Requerida
            p.section-subtitle Prepare estos documentos antes de iniciar el registro

        .docs-grid

          .doc-card.up-surface-card
            .doc-card-icon
              span.material-symbols-outlined domain
            div
              .doc-card-title Registro Único de Contribuyente (RUC)
              p.doc-card-desc Copia digitalizada del RUC vigente emitido por la Dirección General de Ingresos (DGI) de Panamá.
              span.doc-card-required
                span.material-symbols-outlined(style='font-size:0.75rem') priority_high
                | Obligatorio

          .doc-card.up-surface-card
            .doc-card-icon
              span.material-symbols-outlined account_balance
            div
              .doc-card-title Aviso de Operaciones
              p.doc-card-desc Documento emitido por el Ministerio de Comercio e Industrias (MICI) que acredita la operación legal de la empresa.
              span.doc-card-required
                span.material-symbols-outlined(style='font-size:0.75rem') priority_high
                | Obligatorio

          .doc-card.up-surface-card
            .doc-card-icon
              span.material-symbols-outlined badge
            div
              .doc-card-title Cédula del Representante Legal
              p.doc-card-desc Cédula de identidad personal vigente emitida por el Tribunal Electoral de la República de Panamá.
              span.doc-card-required
                span.material-symbols-outlined(style='font-size:0.75rem') priority_high
                | Obligatorio

          .doc-card.up-surface-card
            .doc-card-icon
              span.material-symbols-outlined home_pin
            div
              .doc-card-title Comprobante de Domicilio Fiscal
              p.doc-card-desc Factura de servicio público o contrato de arrendamiento comercial con una antigüedad máxima de 3 meses.
              span.doc-card-required
                span.material-symbols-outlined(style='font-size:0.75rem') priority_high
                | Obligatorio

        .info-notice
          .info-notice-icon
            span.material-symbols-outlined info
          p
            | Todos los documentos deben cargarse en&nbsp;
            strong formato PDF
            | &nbsp;y no deben superar los&nbsp;
            strong 5MB por archivo.&nbsp;
            | Documentos ilegibles, vencidos o en otro formato serán rechazados automáticamente.

      //- ---- FAQ ----
      section
        .section-header
          .section-header-icon.up-gradient-icon
            span.material-symbols-outlined(style='font-variation-settings:"FILL" 1') help
          div
            h2.section-title Preguntas Frecuentes
            p.section-subtitle Respuestas a las dudas más comunes sobre el proceso

        .faq-list

          .faq-item.open.up-surface-card
            button.faq-question(onclick='toggleFaq(this)')
              span &iquest;Cuánto tiempo tarda el proceso de aprobación?
              span.faq-chevron.material-symbols-outlined expand_more
            .faq-answer
              | La Dirección de Vinculación con la Empresa de la UP revisa cada solicitud en un plazo de 48 a 72 horas hábiles desde que se recibe la documentación completa. En temporadas de alta demanda (inicio de semestre) este plazo puede extenderse a 5 días hábiles.

          .faq-item.up-surface-card
            button.faq-question(onclick='toggleFaq(this)')
              span &iquest;Tiene algún costo registrar mi empresa?
              span.faq-chevron.material-symbols-outlined expand_more
            .faq-answer
              | No. El registro y la publicación de vacantes en el Portal de Empleo UP es completamente gratuito para todas las entidades que mantengan un convenio activo con la Universidad de Panamá.

          .faq-item.up-surface-card
            button.faq-question(onclick='toggleFaq(this)')
              span &iquest;Qué tipo de entidades pueden registrarse?
              span.faq-chevron.material-symbols-outlined expand_more
            .faq-answer
              | Pueden registrarse empresas privadas, instituciones públicas, ONGs, firmas de consultoría y cualquier organización legalmente constituida en Panamá que desee contratar o realizar prácticas con estudiantes y egresados de la Universidad de Panamá.

          .faq-item.up-surface-card
            button.faq-question(onclick='toggleFaq(this)')
              span &iquest;Cómo renuevo o actualizo los documentos vencidos?
              span.faq-chevron.material-symbols-outlined expand_more
            .faq-answer
              | Puede actualizar sus documentos en cualquier momento desde su panel de empleador, en la sección &ldquo;Perfil &rsaquo; Estado del convenio&rdquo;. La Dirección de Vinculación revisará los nuevos documentos en el mismo plazo estándar.

          .faq-item.up-surface-card
            button.faq-question(onclick='toggleFaq(this)')
              span &iquest;Necesito un convenio previo con la UP para registrarme?
              span.faq-chevron.material-symbols-outlined expand_more
            .faq-answer
              | No es obligatorio tener un convenio preexistente. Al registrarse, la Dirección de Vinculación evaluará su solicitud e iniciará el proceso de convenio de cooperación institucional de forma paralela a su aprobación.

      //- ---- SECOND CTA ----
      section(style='background: linear-gradient(135deg, var(--up-blue) 0%, var(--up-blue-dark) 100%); border-radius:24px; padding:3rem; position:relative; overflow:hidden; text-align:center')
        div(style='position:absolute; top:-60px; right:-60px; width:200px; height:200px; border-radius:50%; background:rgba(255,255,255,0.04)')
        div(style='position:absolute; bottom:-40px; left:5%; width:160px; height:160px; border-radius:50%; background:rgba(196,154,26,0.08)')
        div(style='position:relative; z-index:1')
          span(style='font-size:0.68rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:var(--up-gold-light); display:block; margin-bottom:0.8rem') Listo para comenzar
          h2(style='font-family:"Sora",sans-serif; font-size:1.8rem; font-weight:800; color:#fff; margin-bottom:0.8rem') Una sola plataforma,
          h2(style='font-family:"Sora",sans-serif; font-size:1.8rem; font-weight:800; color:var(--up-gold-light); margin-bottom:1rem') todo el talento UP
          p(style='color:rgba(255,255,255,0.6); font-size:0.9rem; max-width:480px; margin:0 auto 2rem; line-height:1.7')
            | Acceda al banco de talentos de la universidad con más egresados del país. Inicie su registro hoy.
          a.btn-cta-primary(href='/register' style='display:inline-flex')
            span.material-symbols-outlined(style='font-size:1.05rem; font-variation-settings:"FILL" 1') rocket_launch
            | Comenzar mi Registro

  +publicFooterStrip()

  //- ============================================================
  //- SCRIPTS
  //- ============================================================
  +publicMenuScript()
  script.
    function toggleFaq(btn) {
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('open');
      // Close all
      document.querySelectorAll('.faq-item').forEach(function(el) {
        el.classList.remove('open');
      });
      // Open clicked if it was closed
      if (!isOpen) item.classList.add('open');
    }
