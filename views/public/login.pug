include ./components/head
include ./components/navbar
include ./components/menu-script

doctype html
html(lang='es')
  head
    +publicHead('Iniciar sesión - Portal de Empleo UP')

    style.
      /* ---- MAIN LAYOUT ---- */
      .login-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        position: relative;
        overflow: hidden;
      }

      /* Background decoration */
      .login-main::before {
        content: '';
        position: absolute;
        top: -120px;
        left: -120px;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,56,118,0.06) 0%, transparent 70%);
        pointer-events: none;
      }

      .login-main::after {
        content: '';
        position: absolute;
        bottom: -80px;
        right: -80px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(196,154,26,0.07) 0%, transparent 70%);
        pointer-events: none;
      }

      /* ---- LOGIN CARD ---- */
      .login-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 48px rgba(0,56,118,0.1), 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #e8edf5;
        width: 100%;
        max-width: 480px;
        overflow: hidden;
        position: relative;
        z-index: 1;
      }

      .login-card-header {
        background: linear-gradient(135deg, var(--up-blue) 0%, var(--up-blue-dark) 100%);
        padding: 2rem 2.5rem 2.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .login-card-header::before {
        content: '';
        position: absolute;
        top: -40px;
        right: -40px;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
      }

      .login-card-header::after {
        content: '';
        position: absolute;
        bottom: -60px;
        left: 20px;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: rgba(196,154,26,0.07);
      }

      .login-logo-wrap {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
      }

      .login-logo-bg {
        width: 72px;
        height: 72px;
        background: rgba(255,255,255,0.12);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.2);
      }

      .login-logo-bg .material-symbols-outlined {
        font-size: 2.4rem;
        color: var(--up-gold-light);
        font-variation-settings: 'FILL' 1;
      }

      .login-card-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        position: relative;
        z-index: 1;
        margin-bottom: 0.3rem;
      }

      .login-card-subtitle {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.65);
        position: relative;
        z-index: 1;
      }

      .login-card-body {
        padding: 2rem 2.5rem 2.5rem;
      }

      /* ---- ROLE SELECTOR ---- */
      .role-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.6rem;
        display: block;
      }

      .role-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 1.5rem;
      }

      .role-option {
        position: relative;
        cursor: pointer;
      }

      .role-option input[type='radio'] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }

      .role-card {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        transition: all 0.18s;
        cursor: pointer;
        user-select: none;
      }

      .role-card:hover {
        border-color: #bfdbfe;
        background: #eff6ff;
      }

      .role-option input:checked + .role-card {
        border-color: var(--up-blue);
        background: #eff6ff;
        box-shadow: 0 0 0 3px rgba(0,56,118,0.08);
      }

      .role-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        flex-shrink: 0;
        transition: all 0.18s;
      }

      .role-option input:checked + .role-card .role-icon {
        background: var(--up-blue);
        color: #fff;
      }

      .role-icon .material-symbols-outlined {
        font-size: 1rem;
        font-variation-settings: 'FILL' 1;
      }

      .role-name {
        font-family: 'Sora', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        color: #374151;
        line-height: 1.2;
      }

      .role-option input:checked + .role-card .role-name {
        color: var(--up-blue);
      }

      /* ---- FORM FIELDS ---- */
      .form-divider {
        height: 1px;
        background: #f1f5f9;
        margin-bottom: 1.5rem;
      }

      .field-group {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: 1rem;
      }

      .field-input-icon {
        font-size: 1.1rem;
        font-variation-settings: 'FILL' 0, 'wght' 400;
      }

      /* Password toggle */
      .field-toggle {
        position: absolute;
        right: 13px;
        background: none;
        border: none;
        cursor: pointer;
        color: #94a3b8;
        display: flex;
        align-items: center;
        transition: color 0.2s;
        padding: 0;
      }

      .field-toggle:hover { color: var(--up-blue); }

      /* ---- FORGOT ---- */
      .forgot-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1.5rem;
      }

      .forgot-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--up-blue);
        text-decoration: none;
        transition: color 0.2s;
        padding: 0;
      }

      .forgot-btn:hover { color: var(--up-gold); }

      /* ---- SUBMIT ---- */
      .btn-submit {
        width: 100%;
        height: 48px;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
      }

      /* ---- DIVIDER ---- */
      .or-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.2rem;
        color: #94a3b8;
        font-size: 0.78rem;
      }

      .or-divider::before,
      .or-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e2e8f0;
      }

      /* ---- REGISTER LINK ---- */
      .register-link-row {
        text-align: center;
        font-size: 0.83rem;
        color: #64748b;
      }

      .register-link {
        color: var(--up-blue);
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: color 0.2s, gap 0.2s;
      }

      .register-link:hover { color: var(--up-gold); gap: 7px; }

      /* ---- FOOTER ---- */
      .login-footer {
        text-align: center;
        padding: 1.2rem;
        font-size: 0.72rem;
        color: #94a3b8;
        border-top: 1px solid #f1f5f9;
        background: #fff;
      }

      /* ============================================================
        MODAL DE RECUPERACIÓN DE CONTRASEÑA
        ============================================================ */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        backdrop-filter: blur(4px);
        z-index: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s;
      }

      .modal-overlay.active {
        opacity: 1;
        pointer-events: all;
      }

      .modal-box {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 480px;
        overflow: hidden;
        transform: translateY(16px) scale(0.97);
        transition: transform 0.25s;
      }

      .modal-overlay.active .modal-box {
        transform: translateY(0) scale(1);
      }

      .modal-header {
        background: linear-gradient(135deg, var(--up-blue) 0%, var(--up-blue-dark) 100%);
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .modal-header-content { display: flex; align-items: center; gap: 12px; }

      .modal-header-icon {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.12);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--up-gold-light);
      }

      .modal-title {
        font-family: 'Sora', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
      }

      .modal-subtitle {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.6);
        margin-top: 2px;
      }

      .modal-close-btn {
        background: rgba(255,255,255,0.1);
        border: none;
        color: rgba(255,255,255,0.8);
        border-radius: 8px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        flex-shrink: 0;
      }

      .modal-close-btn:hover { background: rgba(255,255,255,0.2); }

      .modal-body { padding: 2rem; }

      .modal-intro {
        font-size: 0.88rem;
        color: #64748b;
        line-height: 1.7;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .recovery-steps { display: flex; flex-direction: column; gap: 12px; }

      .recovery-step {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 14px 16px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        transition: border-color 0.2s;
      }

      .recovery-step:hover { border-color: #bfdbfe; }

      .step-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Sora', sans-serif;
        font-size: 0.78rem;
        font-weight: 800;
        flex-shrink: 0;
      }

      .step-badge-blue { background: var(--up-blue); color: #fff; }
      .step-badge-gold { background: var(--up-gold); color: #fff; }
      .step-badge-teal { background: #0e7490; color: #fff; }

      .step-content { flex: 1; }

      .step-role {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--up-gold);
        margin-bottom: 2px;
      }

      .step-title-text {
        font-family: 'Sora', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
      }

      .step-detail {
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.5;
      }

      .modal-footer {
        padding: 1rem 2rem 1.5rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fafbfc;
      }

      .modal-contact-icon {
        width: 36px;
        height: 36px;
        background: #eff6ff;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--up-blue);
        flex-shrink: 0;
      }

      .modal-contact-text {
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.5;
      }

      .modal-contact-link {
        color: var(--up-blue);
        font-weight: 600;
        text-decoration: none;
      }

      .modal-contact-link:hover { color: var(--up-gold); }

      /* ---- RESPONSIVE ---- */
      @media (max-width: 640px) {
        .login-card-header { padding: 1.5rem; }
        .login-card-body { padding: 1.5rem; }
        .role-grid { grid-template-columns: 1fr 1fr; }
        .modal-body { padding: 1.5rem; }
        .modal-footer { padding: 1rem 1.5rem; }
      }

  +publicNavbar({ active: 'none', showAuthButtons: false })

  //- ============================================================
  //- MAIN
  //- ============================================================
  main.login-main

    .login-card

      //- Header con gradiente UP
      .login-card-header
        .login-logo-wrap
          .login-logo-bg
            //- Icono original basado en Material Symbols (lo dejamos comentado por si se necesita después)
            //- span.material-symbols-outlined school
            img(src='/images/UP-logo.png' alt='Portal de Empleo UP' style='width:60px; height:60px; border-radius:10px')
        h1.login-card-title Portal de Empleo UP

      //- Formulario
      .login-card-body

        //- Selector de tipo de usuario
        span.role-label(style='margin-bottom:0.5rem; display:block') Soy...
        .role-grid

          label.role-option
            input(type='radio' name='estamento' value='estudiante' checked)
            .role-card
              .role-icon
                span.material-symbols-outlined school
              .role-name Estudiante

          label.role-option
            input(type='radio' name='estamento' value='egresado')
            .role-card
              .role-icon
                span.material-symbols-outlined workspace_premium
              .role-name Egresado

          label.role-option
            input(type='radio' name='estamento' value='empresa')
            .role-card
              .role-icon
                span.material-symbols-outlined business
              .role-name Empresa

          label.role-option
            input(type='radio' name='estamento' value='administrativo')
            .role-card
              .role-icon
                span.material-symbols-outlined manage_accounts
              .role-name Administrativo

        .form-divider

        //- Campos
        form(action='/login' method='POST')
          .field-group

            .field-wrap
              label.field-label(for='cedula') Cédula
              .field-input-wrap
                span.field-input-icon.material-symbols-outlined person
                input#cedula.field-input(
                  type='text'
                  name='cedula'
                  placeholder='8-888-8888'
                  required
                  autocomplete='cedula'
                )

            .field-wrap
              label.field-label(for='password') Contraseña
              .field-input-wrap
                span.field-input-icon.material-symbols-outlined lock
                input#password.field-input(
                  type='password'
                  name='password'
                  placeholder='**************'
                  required
                  autocomplete='current-password'
                  style='padding-right:42px'
                )
                button.field-toggle(type='button' onclick='togglePassword()' aria-label='Mostrar contraseña')
                  span#toggle-icon.material-symbols-outlined(style='font-size:1.1rem; font-variation-settings:"FILL" 0') visibility

          .forgot-row
            button.forgot-btn(type='button' onclick='openModal()') &iquest;Olvidaste tu contraseña?

          button.btn-submit(type='submit')
            | Iniciar Sesión
            span.material-symbols-outlined(style='font-size:1.05rem') arrow_forward

          .or-divider Nueva en el portal?

          .register-link-row
            a.register-link(href='/register')
              | Registrarse como Empresa
              span.material-symbols-outlined(style='font-size:0.95rem') arrow_forward

  //- ============================================================
  //- FOOTER
  //- ============================================================
  footer.login-footer
    | &copy; #{new Date().getFullYear()} Universidad de Panamá &mdash; Dirección de Tecnología de la Información y Comunicación.

  //- ============================================================
  //- MODAL RECUPERACIÓN DE CONTRASEÑA
  //- ============================================================
  #modal-password.modal-overlay(role='dialog' aria-modal='true' aria-labelledby='modal-title')
    .modal-box

      .modal-header
        .modal-header-content
          .modal-header-icon
            span.material-symbols-outlined(style='font-variation-settings:"FILL" 1; font-size:1.2rem') lock_reset
          div
            h2#modal-title.modal-title Recuperar contraseña
            p.modal-subtitle Pasos según tu tipo de usuario
        button.modal-close-btn(onclick='closeModal()' aria-label='Cerrar')
          span.material-symbols-outlined(style='font-size:1.1rem') close

      .modal-body
        p.modal-intro
          | Selecciona tu tipo de usuario a continuación y sigue las instrucciones para recuperar el acceso a tu cuenta.

        .recovery-steps

          .recovery-step
            .step-badge.step-badge-blue 1
            .step-content
              .step-role Estudiantes y Egresados
              .step-title-text Recuperación por correo institucional
              p.step-detail
                | Usa tu correo @up.ac.pa. Recibirás un enlace de restablecimiento en tu bandeja de entrada. Revisa también la carpeta de spam.

          .recovery-step
            .step-badge.step-badge-gold 2
            .step-content
              .step-role Empresas registradas
              .step-title-text Verificación por RUC y correo de contacto
              p.step-detail
                | Ingresa el RUC de tu empresa y el correo con el que te registraste. Recibirás las instrucciones para restablecer tu acceso.

          .recovery-step
            .step-badge.step-badge-teal 3
            .step-content
              .step-role Personal Administrativo
              .step-title-text Contacta a la Dirección de Informática
              p.step-detail
                | El personal administrativo debe solicitar el restablecimiento directamente con la Dirección de Informática de la UP.

      .modal-footer
        .modal-contact-icon
          span.material-symbols-outlined(style='font-variation-settings:"FILL" 1; font-size:1.1rem') support_agent
        p.modal-contact-text
          | &iquest;Necesitas ayuda adicional?
          br
          | Escribenos a&nbsp;
          a.modal-contact-link(href='mailto:vinculacion@up.ac.pa') vinculacion@up.ac.pa
          | &nbsp;o visita&nbsp;
          a.modal-contact-link(href='/contact') Contáctenos

  //- ============================================================
  //- SCRIPTS
  //- ============================================================
  +publicMenuScript()
  script.
    // Toggle password visibility
    function togglePassword() {
      var input = document.getElementById('password');
      var icon = document.getElementById('toggle-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    // Modal
    function openModal() {
      document.getElementById('modal-password').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('modal-password').classList.remove('active');
      document.body.style.overflow = '';
    }

    // Close modal on overlay click
    document.getElementById('modal-password').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });

    // Close modal on ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });

    // Mobile menu behavior is provided by +publicMenuScript()
