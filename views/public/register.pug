include ./components/head
include ./components/navbar
include ./components/footer-strip
include ./components/menu-script

doctype html
html(lang='es')
  head
    +publicHead('Registro de Empleador - Portal de Empleo UP')
    style.
      /* MAIN */
      main{flex:1;padding:3rem 1.5rem 5rem;}
      .reg-wrap{max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:1.8rem;}
      /* PAGE HEADER */
      .page-header{text-align:center;}
      .page-header-icon{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,var(--up-blue),var(--up-blue-dark));display:flex;align-items:center;justify-content:center;color:var(--up-gold-light);margin:0 auto 1.2rem;box-shadow:0 6px 20px rgba(0,56,118,0.2);}
      .page-header-icon .material-symbols-outlined{font-size:1.8rem;font-variation-settings:'FILL' 1;}
      .page-title{font-family:'Sora',sans-serif;font-size:clamp(1.7rem,3vw,2.2rem);font-weight:800;color:#0f172a;margin-bottom:0.4rem;}
      .page-desc{font-size:0.95rem;color:#64748b;line-height:1.7;}
      /* FORM CARD */
      .form-card{border-radius:20px;overflow:hidden;}
      /* SECTION */
      .form-section{padding:1.8rem 2rem;border-bottom:1px solid #f1f5f9;}
      .form-section:last-of-type{border-bottom:none;}
      .section-heading{display:flex;align-items:center;gap:10px;margin-bottom:1.4rem;}
      .section-heading-icon{width:34px;height:34px;border-radius:9px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:var(--up-blue);flex-shrink:0;}
      .section-heading-icon .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .section-heading-label{font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--up-gold);}
      .section-heading-title{font-family:'Sora',sans-serif;font-size:0.95rem;font-weight:800;color:#0f172a;}
      /* GRID */
      .fg{display:grid;gap:1rem;}
      .fg-2{grid-template-columns:1fr 1fr;}
      .fg-3{grid-template-columns:1fr 1fr 1fr;}
      /* FIELD */
      .fw{display:flex;flex-direction:column;gap:5px;}
      .fl{font-size:0.82rem;font-weight:600;color:#374151;}
      .fl span{color:#e11d48;margin-left:2px;}
      .fi-wrap{position:relative;display:flex;align-items:center;}
      .fi{position:absolute;left:13px;color:#94a3b8;font-size:1rem;font-variation-settings:'FILL' 0;pointer-events:none;}
      .fi-top{top:13px;align-self:flex-start;}
      .finput,.fselect,.ftarea{width:100%;border-radius:10px;border:1.5px solid #e2e8f0;background:#f8fafc;font-family:'DM Sans',sans-serif;font-size:0.88rem;color:#1a2233;outline:none;transition:border-color 0.18s,box-shadow 0.18s;}
      .finput,.fselect{height:46px;padding:0 14px 0 40px;}
      .fselect{cursor:pointer;}
      .ftarea{padding:12px 14px 12px 40px;resize:vertical;min-height:100px;line-height:1.6;}
      .finput:focus,.fselect:focus,.ftarea:focus{border-color:var(--up-blue);background:#fff;box-shadow:0 0 0 3px rgba(0,56,118,0.08);}
      .finput::placeholder,.ftarea::placeholder{color:#b0bec5;}
      /* PASSWORD STRENGTH */
      .pw-strength{display:flex;gap:4px;margin-top:6px;}
      .pw-bar{height:3px;flex:1;border-radius:2px;background:#e2e8f0;transition:background 0.3s;}
      .pw-bar.weak{background:#ef4444;}
      .pw-bar.medium{background:#f59e0b;}
      .pw-bar.strong{background:#22c55e;}
      .pw-label{font-size:0.72rem;color:#94a3b8;margin-top:3px;}
      /* FILE UPLOAD */
      .file-drop{border:2px dashed #d1d9e6;border-radius:12px;padding:1.5rem;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:#fafbfc;}
      .file-drop:hover,.file-drop.dragover{border-color:var(--up-blue);background:#f0f5ff;}
      .file-drop-icon{color:#94a3b8;font-size:2rem;font-variation-settings:'FILL' 1;transition:color 0.2s;}
      .file-drop:hover .file-drop-icon{color:var(--up-blue);}
      .file-drop-text{font-size:0.85rem;color:#64748b;text-align:center;}
      .file-drop-text strong{color:var(--up-blue);cursor:pointer;}
      .file-drop-meta{font-size:0.72rem;color:#94a3b8;}
      .file-drop-note{font-size:0.75rem;color:#94a3b8;font-style:italic;margin-top:4px;}
      .file-name{display:none;align-items:center;gap:8px;padding:8px 12px;background:#eff6ff;border-radius:8px;font-size:0.82rem;color:var(--up-blue);font-weight:600;margin-top:6px;}
      .file-name .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      /* CHECKBOXES */
      .checks-section{padding:1.5rem 2rem;border-top:1px solid #f1f5f9;display:flex;flex-direction:column;gap:12px;}
      .check-row{display:flex;align-items:flex-start;gap:10px;}
      .check-row input[type='checkbox']{width:16px;height:16px;margin-top:2px;flex-shrink:0;accent-color:var(--up-blue);cursor:pointer;}
      .check-label{font-size:0.8rem;color:#475569;line-height:1.6;cursor:pointer;}
      .check-label a{color:var(--up-blue);font-weight:600;text-decoration:none;}
      .check-label a:hover{color:var(--up-gold);}
      /* SUBMIT */
      .form-footer{padding:1.5rem 2rem;background:#fafbfc;border-top:1px solid #f1f5f9;}
      .btn-submit{width:100%;height:52px;font-size:1rem;}
      /* LOGIN LINK */
      .login-redirect{text-align:center;font-size:0.85rem;color:#64748b;padding-top:0.3rem;}
      .login-redirect a{color:var(--up-blue);font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;transition:color 0.2s,gap 0.2s;}
      .login-redirect a:hover{color:var(--up-gold);gap:7px;}
      /* STEP INDICATOR */
      .steps-indicator{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:0.5rem;}
      .step-pill{display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:50px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:700;}
      .step-pill.active{background:var(--up-blue);color:#fff;}
      .step-pill.done{background:#dcfce7;color:#15803d;}
      .step-pill.inactive{background:#f1f5f9;color:#94a3b8;}
      .step-connector{width:32px;height:2px;background:#e2e8f0;}
      /* RESPONSIVE */
      @media(max-width:900px){
        .fg-3{grid-template-columns:1fr 1fr;}
      }
      @media(max-width:640px){
        .fg-2,.fg-3{grid-template-columns:1fr;}
        .form-section{padding:1.4rem 1.2rem;}
        .checks-section{padding:1.2rem;}
        .form-footer{padding:1.2rem;}
      }

  +publicNavbar({ active: 'none' })

  main
    .reg-wrap

      //- PAGE HEADER
