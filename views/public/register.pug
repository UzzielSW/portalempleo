          | Aprobación

      //- FORM CARD
      .form-card.up-surface-card
        form(action='/registro/empleador' method='POST' enctype='multipart/form-data' onsubmit='handleSubmit(event)')

          //- 1. CREDENCIALES
          .form-section
            .section-heading
              .section-heading-icon
                span.material-symbols-outlined lock
              div
                .section-heading-label Seccion 1
                .section-heading-title Credenciales de Acceso
            .fg.fg-1(style='grid-template-columns:1fr;gap:1rem')
