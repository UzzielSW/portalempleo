  +publicFooterStrip()

  +publicMenuScript()

  script.
    const direcciones_panama = !{JSON.stringify(direcciones_panama)};

    function togglePw(id,iconId){
      var inp=document.getElementById(id);
      var ic=document.getElementById(iconId);
      if(inp.type==='password'){inp.type='text';ic.textContent='visibility_off';}
      else{inp.type='password';ic.textContent='visibility';}
    }

    function checkStrength(val){
      var bars=[document.getElementById('bar1'),document.getElementById('bar2'),document.getElementById('bar3'),document.getElementById('bar4')];
      var label=document.getElementById('pw-label');
      bars.forEach(function(b){b.className='pw-bar';});
      if(val.length===0){label.textContent='Ingrese su contraseña';return;}
      var score=0;
      if(val.length>=8)score++;
      if(val.length>=12)score++;
      if(/[A-Z]/.test(val)&&/[0-9]/.test(val))score++;
      if(/[^A-Za-z0-9]/.test(val))score++;
      var cls=score<=1?'weak':score<=2?'medium':'strong';
      var lbl=score<=1?'Débil':score<=2?'Moderada':'Fuerte';
      for(var i=0;i<score;i++)bars[i].classList.add(cls);
      label.textContent='Seguridad: '+lbl;
      label.style.color=score<=1?'#ef4444':score<=2?'#f59e0b':'#22c55e';
    }

    function dragOver(e){e.preventDefault();document.getElementById('drop-zone').classList.add('dragover');}
    function dragLeave(e){document.getElementById('drop-zone').classList.remove('dragover');}
    function dropFile(e){
      e.preventDefault();
      document.getElementById('drop-zone').classList.remove('dragover');
      var files=e.dataTransfer.files;
      if(files.length>0)showFile(files[0]);
    }
    function fileSelected(input){if(input.files.length>0)showFile(input.files[0]);}
    function showFile(file){
      var disp=document.getElementById('file-name-display');
      var nameEl=document.getElementById('file-name-text');
      if(file.size>5*1024*1024){alert('El archivo supera el limite de 5MB.');return;}
      nameEl.textContent=file.name;
      disp.style.display='flex';
    }

    // Referencias a los selects (mejor tenerlas en variables globales para no buscarlas a cada rato)
    const selectProvincia = document.getElementById('provincia');
    const selectDistrito = document.getElementById('distrito');
    const selectCorregimiento = document.getElementById('corregimiento');

    // 2. Función para cargar las Provincias al iniciar la página
    function initProvincias() {
      selectProvincia.innerHTML = '<option value="">Seleccione Provincia...</option>';

      // Recorremos el arreglo "provincia" de tu JSON
      direcciones_panama.provincia.forEach(function(p) {
        let opt = document.createElement('option');
        opt.value = p.nombre;
        opt.textContent = p.nombre;
        selectProvincia.appendChild(opt);
      });
    }

    // 3. Función que se ejecuta cuando el usuario cambia la PROVINCIA
    function loadDistritos() {
      let provSeleccionada = selectProvincia.value;

      // Reseteamos siempre los hijos y nietos
      selectDistrito.innerHTML = '<option value="">Seleccione Distrito...</option>';
      selectCorregimiento.innerHTML = '<option value="">Seleccione primero...</option>';

      if (!provSeleccionada) return; // Si elige "Seleccione...", no hace nada

      // Buscamos el objeto de la provincia seleccionada en el JSON
      let datosProv = direcciones_panama.provincia.find(p => p.nombre === provSeleccionada);

      // Si la encuentra, iteramos sobre sus distritos
      if (datosProv && datosProv.distrito) {
        datosProv.distrito.forEach(function(d) {
          let opt = document.createElement('option');
          opt.value = d.nombre;
          opt.textContent = d.nombre;
          selectDistrito.appendChild(opt);
        });
      }
    }

    // 4. Función que se ejecuta cuando el usuario cambia el DISTRITO
    function loadCorregimientos() {
      let provSeleccionada = selectProvincia.value;
      let distSeleccionado = selectDistrito.value;

      // Reseteamos los corregimientos
      selectCorregimiento.innerHTML = '<option value="">Seleccione Corregimiento...</option>';

      if (!provSeleccionada || !distSeleccionado) return;

      // Buscamos la provincia primero
      let datosProv = direcciones_panama.provincia.find(p => p.nombre === provSeleccionada);

      if (datosProv && datosProv.distrito) {
        // Dentro de la provincia, buscamos el distrito específico
        let datosDist = datosProv.distrito.find(d => d.nombre === distSeleccionado);

        // Si lo encuentra, iteramos sobre sus corregimientos
        if (datosDist && datosDist.corregimientos) {
          datosDist.corregimientos.forEach(function(c) {
            let opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            selectCorregimiento.appendChild(opt);
          });
        }
      }
    }

    // 5. Inicializar la vista (Llamamos a esta función apenas carga tu JS)
    initProvincias();

    //---------------------------------------------

    function handleSubmit(e){
      var pw=document.getElementById('password').value;
      var cpw=document.getElementById('confirm_password').value;
      if(pw!==cpw){e.preventDefault();alert('Las contraseñas no coinciden.');return;}
    }

