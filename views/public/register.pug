                    type='password' name='confirm_password'
                    placeholder='Repita su contraseña'
                    required
                    style='padding-right:42px'
                  )
                  button(type='button' onclick='togglePw("confirm_password","icon-cpw")' style='position:absolute;right:13px;background:none;border:none;cursor:pointer;color:#94a3b8;display:flex;align-items:center;' aria-label='Ver contraseña')
                    span#icon-cpw.material-symbols-outlined(style='font-size:1.05rem;font-variation-settings:"FILL" 0') visibility

          //- 2. INFO ENTIDAD
          .form-section
            .section-heading
              .section-heading-icon
                span.material-symbols-outlined business
