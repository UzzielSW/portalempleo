  script.
    // Consent modal
    var consented = sessionStorage.getItem('up_employer_consent');
    if(!consented) {
      document.getElementById('consent-modal').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function updateAccept() {
      var c1 = document.getElementById('check-consent').checked;
      var c2 = document.getElementById('check-terms').checked;
      document.getElementById('btn-accept').disabled = !(c1 && c2);
    }

    function acceptConsent() {
      sessionStorage.setItem('up_employer_consent','1');
      var m = document.getElementById('consent-modal');
      m.style.opacity = '0';
      m.style.transition = 'opacity 0.3s';
      setTimeout(function(){ m.style.display = 'none'; document.body.style.overflow = ''; }, 300);
    }

    function declineConsent() {
      window.location.href = '/';
    }

    function applyR() {
      var w = window.innerWidth;
      var pg = document.querySelector('.page-grid');
      var sr = document.querySelector('.stats-row');
      if(pg) pg.style.gridTemplateColumns = w < 1024 ? '1fr' : '1fr 300px';
      if(sr) sr.style.gridTemplateColumns = w < 640 ? '1fr 1fr' : 'repeat(4, 1fr)';
    }
    applyR();
    window.addEventListener('resize', applyR);
