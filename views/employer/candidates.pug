doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Gestion de Candidatos - Portal de Empleo UP
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200')
    link(rel="icon", type="image/x-icon", href="/images/favicon.ico")
    style.
      :root{--up-blue:#003876;--up-blue-dark:#002147;--up-gold:#C49A1A;--up-gold-light:#e8c44d;--bg:#f0f4f8;}
      *{box-sizing:border-box;margin:0;padding:0;}
      body{font-family:'DM Sans',sans-serif;background:var(--bg);color:#1a2233;min-height:100vh;display:flex;flex-direction:column;}
      h1,h2,h3,h4{font-family:'Sora',sans-serif;}
      .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;}

      /* TOPBAR */
      .topbar{background:var(--up-blue);color:#fff;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,56,118,0.18);}
      .topbar-inner{max-width:1280px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:64px;}
      .topbar-brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0;}
      .topbar-brand-icon{background:var(--up-gold);border-radius:9px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:var(--up-blue);flex-shrink:0;}
      .topbar-brand-name{font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;line-height:1.1;}
      .topbar-brand-sub{font-size:0.58rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--up-gold-light);}

      .topbar-nav{display:flex;align-items:center;height:100%;}
      .topbar-nav a{display:flex;align-items:center;height:100%;padding:0 1rem;font-size:0.82rem;font-weight:600;color:rgba(255,255,255,0.65);text-decoration:none;border-bottom:3px solid transparent;transition:color 0.2s,border-color 0.2s;white-space:nowrap;}
      .topbar-nav a:hover{color:#fff;}
      .topbar-nav a.active{color:#fff;border-bottom-color:var(--up-gold);}
      .topbar-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
      .topbar-icon-btn{background:rgba(255,255,255,0.08);border:none;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.75);cursor:pointer;transition:background 0.2s;position:relative;}
      .topbar-icon-btn:hover{background:rgba(255,255,255,0.16);color:#fff;}
      .notif-dot{position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--up-gold);border:2px solid var(--up-blue);}
      .topbar-divider{width:1px;height:28px;background:rgba(255,255,255,0.15);margin:0 4px;}
      .topbar-user{display:flex;align-items:center;gap:9px;cursor:pointer;padding:4px 8px;border-radius:10px;transition:background 0.2s;}
      .topbar-user:hover{background:rgba(255,255,255,0.08);}
      .topbar-user-name{font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#fff;line-height:1.15;}
      .topbar-user-sub{font-size:0.58rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--up-gold-light);}
      .topbar-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--up-gold),#a07a10);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;flex-shrink:0;}

      /* MAIN */
      .main-content{flex:1;max-width:1280px;margin:0 auto;width:100%;padding:2rem 1.5rem 4rem;}

      /* PAGE HEADER */
      .page-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;}
      .page-title{font-family:'Sora',sans-serif;font-size:1.6rem;font-weight:800;color:#0f172a;}
      .page-subtitle{font-size:0.88rem;color:#64748b;margin-top:3px;}
      .header-actions{display:flex;gap:8px;flex-wrap:wrap;}
      .btn-primary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 18px;border-radius:10px;background:var(--up-blue);color:#fff;border:none;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;cursor:pointer;transition:all 0.2s;box-shadow:0 3px 10px rgba(0,56,118,0.2);}
      .btn-primary:hover{background:var(--up-gold);}
      .btn-primary .material-symbols-outlined{font-size:1rem;font-variation-settings:'FILL' 1;}
      .btn-secondary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;color:#334155;cursor:pointer;transition:all 0.2s;}
      .btn-secondary:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .btn-secondary .material-symbols-outlined{font-size:1rem;}

      /* STATS */
      .stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:1.5rem;}
      .stat-card{background:#fff;border-radius:14px;border:1.5px solid #e8edf5;padding:1rem 1.2rem;display:flex;align-items:center;gap:12px;cursor:pointer;transition:border-color 0.2s,box-shadow 0.2s;}
      .stat-card:hover,.stat-card.active{border-color:var(--up-blue);box-shadow:0 4px 16px rgba(0,56,118,0.1);}
      .stat-card.active{background:#eff6ff;}
      .stat-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
      .stat-icon .material-symbols-outlined{font-size:1.1rem;font-variation-settings:'FILL' 1;}
      .si-all{background:#f1f5f9;color:#64748b;}
      .si-blue{background:#eff6ff;color:var(--up-blue);}
      .si-amber{background:#fefce8;color:#a16207;}
      .si-green{background:#f0fdf4;color:#15803d;}
      .si-red{background:#fef2f2;color:#dc2626;}
      .stat-num{font-family:'Sora',sans-serif;font-size:1.3rem;font-weight:800;color:#0f172a;line-height:1;}
      .stat-label{font-size:0.7rem;color:#94a3b8;margin-top:1px;font-weight:600;}

      /* FILTER BAR */
      .filter-bar{background:#fff;border-radius:16px;border:1.5px solid #e8edf5;padding:1rem 1.4rem;display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:1.2rem;box-shadow:0 2px 8px rgba(0,56,118,0.04);}
      .filter-search{display:flex;align-items:center;gap:8px;flex:1;min-width:220px;background:#f8fafc;border:1.5px solid #f1f5f9;border-radius:10px;padding:0 12px;height:40px;transition:border-color 0.2s;}
      .filter-search:focus-within{border-color:var(--up-blue);background:#fff;}
      .filter-search .material-symbols-outlined{font-size:1rem;color:#94a3b8;}
      .filter-search input{background:none;border:none;outline:none;font-family:'DM Sans',sans-serif;font-size:0.85rem;color:#334155;width:100%;}
      .filter-search input::placeholder{color:#b0bec5;}
      .fsel-wrap{position:relative;}
      .fsel-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:0.95rem;color:#64748b;pointer-events:none;font-variation-settings:'FILL' 1;}
      .fsel{height:40px;padding:0 30px 0 32px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'DM Sans',sans-serif;font-size:0.83rem;font-weight:600;color:#334155;cursor:pointer;outline:none;appearance:none;}
      .fsel:focus{border-color:var(--up-blue);}
      .fchev{position:absolute;right:9px;top:50%;transform:translateY(-50%);font-size:0.85rem;color:#94a3b8;pointer-events:none;}
      .btn-export{display:inline-flex;align-items:center;gap:5px;height:40px;padding:0 14px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#64748b;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
      .btn-export:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .btn-export .material-symbols-outlined{font-size:0.95rem;}

      /* STATUS TABS */
      .status-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:1.2rem;}
      .stab{display:inline-flex;align-items:center;gap:5px;height:32px;padding:0 12px;border-radius:50px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:700;color:#64748b;cursor:pointer;transition:all 0.2s;}
      .stab:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .stab.active{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .stab-count{font-size:0.65rem;font-weight:800;padding:1px 6px;border-radius:50px;}
      .stab.active .stab-count{background:rgba(255,255,255,0.2);}
      .stab:not(.active) .stab-count{background:#f1f5f9;color:#64748b;}

      /* MAIN TABLE CARD */
      .table-card{background:#fff;border-radius:18px;border:1.5px solid #e8edf5;box-shadow:0 2px 12px rgba(0,56,118,0.05);overflow:hidden;}
      .table-head{display:grid;grid-template-columns:2.2fr 1.2fr 1.4fr 1fr 1.1fr 1fr 1.2fr;column-gap:1rem;align-items:center;padding:0.8rem 1.4rem;background:#f8fafc;border-bottom:1px solid #f1f5f9;}
      .th{font-size:0.65rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#94a3b8;}
      .th.sort{cursor:pointer;display:flex;align-items:center;gap:3px;transition:color 0.2s;}
      .th.sort:hover{color:var(--up-blue);}
      .th.sort .material-symbols-outlined{font-size:0.8rem;}

      /* CANDIDATE ROW */
      .cand-row{display:grid;grid-template-columns:2.2fr 1.2fr 1.4fr 1fr 1.1fr 1fr 1.2fr;column-gap:1rem;align-items:center;padding:0.9rem 1.4rem;border-bottom:1px solid #f8fafc;transition:background 0.15s;cursor:pointer;}
      .cand-row:last-child{border-bottom:none;}
      .cand-row:hover{background:#fafbfc;}

      /* Candidate identity cell */
      .cand-identity{display:flex;align-items:center;gap:10px;}
      .cand-avatar{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:0.85rem;font-weight:800;flex-shrink:0;position:relative;}
      .online-dot{position:absolute;bottom:1px;right:1px;width:9px;height:9px;border-radius:50%;background:#22c55e;border:2px solid #fff;}
      .cand-name{font-family:'Sora',sans-serif;font-size:0.87rem;font-weight:700;color:#0f172a;}
      .cand-email{font-size:0.72rem;color:#94a3b8;margin-top:1px;}

      /* Match score */
      .match-score{display:flex;align-items:center;gap:6px;}
      .match-ring{width:36px;height:36px;position:relative;flex-shrink:0;}
      .match-ring svg{width:36px;height:36px;transform:rotate(-90deg);}
      .match-ring-bg{fill:none;stroke:#f1f5f9;stroke-width:3;}
      .match-ring-fill{fill:none;stroke-width:3;stroke-linecap:round;transition:stroke-dashoffset 0.5s;}
      .match-pct{font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:800;color:#0f172a;}

      /* Career */
      .cand-career{font-size:0.82rem;color:#334155;font-weight:500;}
      .cand-faculty{font-size:0.7rem;color:#94a3b8;margin-top:1px;}

      /* Vacancy pill */
      .vac-pill{display:inline-flex;align-items:center;font-size:0.7rem;font-weight:700;padding:3px 10px;border-radius:50px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
      .vp-blue{background:#eff6ff;color:var(--up-blue);border:1px solid #bfdbfe;}
      .vp-gold{background:#fefce8;color:#a16207;border:1px solid #fde68a;}
      .vp-green{background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;}
      .vp-purple{background:#faf5ff;color:#6d28d9;border:1px solid #ddd6fe;}

      /* Date */
      .cand-date{font-size:0.82rem;color:#64748b;}
      .cand-days{font-size:0.7rem;color:#94a3b8;margin-top:1px;}

      /* Status badges */
      .sbadge{display:inline-flex;align-items:center;gap:5px;font-size:0.68rem;font-weight:700;padding:4px 10px;border-radius:50px;letter-spacing:0.04em;}
      .sdot{width:5px;height:5px;border-radius:50%;flex-shrink:0;}
      .sb-review{background:#eff6ff;color:#1e40af;}.sb-review .sdot{background:#3b82f6;animation:pulse 2s infinite;}
      .sb-interview{background:#fefce8;color:#92400e;}.sb-interview .sdot{background:#f59e0b;animation:pulse 2s infinite;}
      .sb-accepted{background:#f0fdf4;color:#15803d;}.sb-accepted .sdot{background:#22c55e;}
      .sb-rejected{background:#fef2f2;color:#dc2626;}.sb-rejected .sdot{background:#ef4444;}
      .sb-new{background:#faf5ff;color:#6d28d9;}.sb-new .sdot{background:#8b5cf6;animation:pulse 2s infinite;}
      @keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}

      /* Row actions */
      .row-actions{display:flex;align-items:center;gap:4px;justify-content:flex-end;}
      .act-btn{height:30px;padding:0 10px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;display:inline-flex;align-items:center;gap:4px;color:#64748b;cursor:pointer;transition:all 0.2s;font-family:'Sora',sans-serif;font-size:0.72rem;font-weight:700;}
      .act-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .act-btn.primary{background:var(--up-blue);color:#fff;border-color:var(--up-blue);}
      .act-btn.primary:hover{background:var(--up-gold);border-color:var(--up-gold);}
      .act-btn .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;}
      .act-icon-btn{width:30px;height:30px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;display:flex;align-items:center;justify-content:center;color:#64748b;cursor:pointer;transition:all 0.2s;}
      .act-icon-btn:hover{border-color:var(--up-blue);color:var(--up-blue);}
      .act-icon-btn.danger:hover{border-color:#ef4444;color:#ef4444;}
      .act-icon-btn .material-symbols-outlined{font-size:0.95rem;}

      /* TABLE FOOTER */
      .table-footer{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.4rem;border-top:1px solid #f1f5f9;flex-wrap:wrap;gap:0.8rem;}
      .tf-info{font-size:0.78rem;color:#94a3b8;}
      .tf-pages{display:flex;align-items:center;gap:6px;}
      .page-btn{width:32px;height:32px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:700;color:#334155;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;}
      .page-btn:hover{border-color:var(--up-blue);color:var,--up-blue;}
      .page-btn.active{background:var(--up-blue);color:#fff;border-color:var,--up-blue;}
      .page-btn:disabled{color:#cbd5e1;cursor:not-allowed;}

      /* ===== DRAWER ===== */
      .drawer-overlay{position:fixed;inset:0;background:rgba(0,20,50,0.55);backdrop-filter:blur(4px);z-index:200;display:none;}
      .drawer-overlay.open{display:block;}
      .drawer{position:fixed;top:0;right:0;bottom:0;width:480px;max-width:100vw;background:#fff;z-index:201;box-shadow:-8px 0 40px rgba(0,0,0,0.1);transform:translateX(100%);transition:transform 0.3s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column;}
      .drawer.open{transform:translateX(0);}

      .drawer-header{background:linear-gradient(135deg,var(--up-blue),var(--up-blue-dark));padding:1.4rem 1.6rem;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
      .dh-left{display:flex;align-items:center;gap:12px;}
      .dh-avatar{width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;flex-shrink:0;border:2px solid rgba(255,255,255,0.25);}
      .dh-name{font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;color:#fff;}
      .dh-sub{font-size:0.72rem;color:rgba(255,255,255,0.6);margin-top:1px;}
      .drawer-close{background:rgba(255,255,255,0.12);border:none;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;transition:background 0.2s;flex-shrink:0;}
      .drawer-close:hover{background:rgba(255,255,255,0.22);}
      .drawer-close .material-symbols-outlined{font-size:1.1rem;}

      .drawer-tabs{display:flex;background:#fff;border-bottom:1px solid #f1f5f9;flex-shrink:0;}
      .dtab{flex:1;height:44px;display:flex;align-items:center;justify-content:center;gap:5px;font-family:'Sora',sans-serif;font-size:0.75rem;font-weight:700;color:#94a3b8;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s;background:none;border-top:none;border-left:none;border-right:none;}
      .dtab:hover{color:var(--up-blue);}
      .dtab.active{color:var(--up-blue);border-bottom-color:var(--up-blue);}
      .dtab .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;}

      .drawer-body{flex:1;overflow-y:auto;padding:1.4rem 1.6rem;}
      .drawer-body::-webkit-scrollbar{width:4px;}
      .drawer-body::-webkit-scrollbar-thumb{background:#e2e8f0;border-radius:4px;}

      .drawer-panel{display:none;}
      .drawer-panel.active{display:block;}

      /* Drawer sections */
      .ds-title{font-family:'Sora',sans-serif;font-size:0.7rem;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#94a3b8;margin-bottom:0.8rem;margin-top:1.2rem;}
      .ds-title:first-child{margin-top:0;}
      .ds-card{background:#f8fafc;border-radius:12px;border:1px solid #f1f5f9;padding:1rem;margin-bottom:1rem;}
      .ds-row{display:flex;align-items:flex-start;gap:8px;padding:7px 0;border-bottom:1px solid #f1f5f9;}
      .ds-row:last-child{border-bottom:none;}
      .ds-icon{color:#94a3b8;flex-shrink:0;margin-top:1px;}
      .ds-icon .material-symbols-outlined{font-size:0.95rem;font-variation-settings:'FILL' 1;}
      .ds-label{font-size:0.62rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#94a3b8;}
      .ds-value{font-size:0.83rem;font-weight:600;color:#334155;}

      /* Match details */
      .match-detail-bar{margin-bottom:0.8rem;}
      .mdb-header{display:flex;justify-content:space-between;margin-bottom:4px;}
      .mdb-label{font-size:0.78rem;font-weight:600;color:#334155;}
      .mdb-pct{font-family:'Sora',sans-serif;font-size:0.78rem;font-weight:800;}
      .mdb-bar-bg{height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;}
      .mdb-bar{height:6px;border-radius:3px;}
      .bar-blue{background:var(--up-blue);}
      .bar-gold{background:var(--up-gold);}
      .bar-green{background:#22c55e;}
      .bar-red{background:#ef4444;}

      /* Timeline drawer */
      .timeline{display:flex;flex-direction:column;gap:0;position:relative;}
      .timeline::before{content:'';position:absolute;left:14px;top:14px;bottom:14px;width:2px;background:#f1f5f9;}
      .tl-step{display:flex;gap:12px;align-items:flex-start;position:relative;z-index:1;padding-bottom:1.2rem;}
      .tl-step:last-child{padding-bottom:0;}
      .tl-circle{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:2px solid;}
      .tl-done{background:#eff6ff;border-color:var(--up-blue);}
      .tl-done .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;color:var(--up-blue);}
      .tl-current{background:var(--up-gold);border-color:var(--up-gold);box-shadow:0 0 0 4px rgba(196,154,26,0.2);}
      .tl-current .material-symbols-outlined{font-size:0.9rem;font-variation-settings:'FILL' 1;color:#fff;}
      .tl-pending{background:#f8fafc;border-color:#e2e8f0;}
      .tl-pending .material-symbols-outlined{font-size:0.9rem;color:#cbd5e1;}
      .tl-title{font-family:'Sora',sans-serif;font-size:0.83rem;font-weight:700;color:#0f172a;padding-top:3px;}
      .tl-date{font-size:0.72rem;color:#94a3b8;margin-top:1px;}
      .tl-note{font-size:0.78rem;color:#64748b;line-height:1.6;margin-top:5px;padding:8px 10px;background:#f8fafc;border-radius:8px;border-left:3px solid var(--up-gold);}

      /* Drawer action strip */
      .drawer-actions{padding:1rem 1.6rem;border-top:1px solid #f1f5f9;display:flex;gap:8px;flex-shrink:0;}
      .dact-btn{flex:1;height:42px;display:flex;align-items:center;justify-content:center;gap:6px;border-radius:10px;font-family:'Sora',sans-serif;font-size:0.82rem;font-weight:700;cursor:pointer;transition:all 0.2s;border:none;}
      .dact-primary{background:var(--up-blue);color:#fff;box-shadow:0 3px 10px rgba(0,56,118,0.2);}
