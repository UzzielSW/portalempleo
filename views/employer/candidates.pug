  script.
    function openDrawer(key) {
      document.getElementById('drawer-overlay').classList.add('open');
      document.getElementById('drawer').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      document.getElementById('drawer-overlay').classList.remove('open');
      document.getElementById('drawer').classList.remove('open');
      document.body.style.overflow = '';
    }
    function switchDTab(tab) {
      document.querySelectorAll('.dtab').forEach(function(t){ t.classList.remove('active'); });
      document.querySelectorAll('.drawer-panel').forEach(function(p){ p.classList.remove('active'); });
      document.getElementById('dtab-' + tab).classList.add('active');
      document.getElementById('dpanel-' + tab).classList.add('active');
    }
    function filterTab(btn) {
      document.querySelectorAll('.stab').forEach(function(t){ t.classList.remove('active'); });
      btn.classList.add('active');
    }
    function filterStatus(s) {
      document.querySelectorAll('.stat-card').forEach(function(c){ c.classList.remove('active'); });
      event.currentTarget.classList.add('active');
    }
    function applyR() {
      var w = window.innerWidth;
      var sr = document.querySelector('.stats-row');
      if(!sr) return;
      if(w < 480) sr.style.gridTemplateColumns = 'repeat(2, 1fr)';
      else if(w < 1024) sr.style.gridTemplateColumns = 'repeat(3, 1fr)';
      else sr.style.gridTemplateColumns = 'repeat(5, 1fr)';
    }
    applyR();
    window.addEventListener('resize', applyR);
