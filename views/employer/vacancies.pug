  script.
    function switchView(view) {
      document.querySelectorAll('.view').forEach(function(v) { v.classList.remove('active'); });
      document.querySelectorAll('.subnav-btn').forEach(function(b) { b.classList.remove('active'); });
      document.getElementById('view-' + view).classList.add('active');
      document.getElementById('btn-' + (view === 'publicadas' ? 'publicadas' : 'crear')).classList.add('active');
      window.scrollTo({top:0, behavior:'smooth'});
    }

    // Modality selector
    document.querySelectorAll('.modality-opt').forEach(function(opt) {
      opt.addEventListener('click', function() {
        document.querySelectorAll('.modality-opt').forEach(function(o) { o.classList.remove('selected'); });
        this.classList.add('selected');
      });
    });

    // Jornada toggle
    document.querySelectorAll('.jornada-opt').forEach(function(opt) {
      opt.addEventListener('click', function() {
        this.classList.toggle('selected');
      });
    });

    // Status tabs
    document.querySelectorAll('.status-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.status-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
      });
    });

    // Tags input (skills example)
    var skillInput = document.getElementById('skill-input');
    var skillsWrap = document.getElementById('skills-wrap');
    if(skillInput) {
      skillInput.addEventListener('keydown', function(e) {
        if((e.key === 'Enter' || e.key === ',') && this.value.trim()) {
          e.preventDefault();
          var tag = document.createElement('span');
          tag.className = 'tag-pill';
          tag.innerHTML = this.value.trim() + '<button class="tag-remove" onclick="this.parentElement.remove()">&times;</button>';
          skillsWrap.insertBefore(tag, this);
          this.value = '';
        }
      });
    }

    // Responsive layout
    function applyR() {
      var w = window.innerWidth;
      var cl = document.querySelector('.create-layout');
      if(cl) cl.style.gridTemplateColumns = w < 1024 ? '1fr' : '1fr 280px';
      var sr = document.querySelector('.stats-row');
      if(sr) sr.style.gridTemplateColumns = w < 480 ? '1fr 1fr' : (w < 1024 ? 'repeat(2, 1fr)' : 'repeat(4, 1fr)');
    }
    applyR();
    window.addEventListener('resize', applyR);
