@startuml
left to right direction
skinparam packageStyle rectangle

actor "Administrador Portal Empleo UP" as A

rectangle "Portal de Empleo UP - Módulo de Administrador" {
    usecase "UC-14: Validar y Aprobar\nConvenios" as UC14
    usecase "UC-15: Gestionar Entidades\ny Usuarios" as UC15
    usecase "UC-16: Visualizar Tableros\ny Reportes" as UC16
    usecase "UC-17: Auditar Ofertas y\nPostulaciones" as UC17
}

A --> UC14
A --> UC15
A --> UC16
A --> UC17
@enduml