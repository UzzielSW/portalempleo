@startuml
left to right direction
skinparam packageStyle rectangle

actor "Candidato\n(Estudiante/Egresado)" as C

rectangle "Portal de Empleo UP - Módulo Candidato" {
    usecase "UC-01: Iniciar Sesión\n(Autenticación Integrada)" as UC1
    usecase "UC-02: Visualizar Perfil\nAcadémico Validado" as UC2
    usecase "UC-03: Gestionar Hoja de Vida (CV)" as UC3
    usecase "UC-04: Buscar Ofertas de Empleo\n(Filtros Avanzados)" as UC4
    usecase "UC-05: Postular a Vacante" as UC5
    usecase "UC-06: Consultar Estado de\nPostulaciones" as UC6
    usecase "UC-07: Evaluar Empleador (Score)" as UC7

    usecase "Validar Requisitos del Perfil" as UC_VAL
    usecase "Sincronizar Datos Externos" as UC_SYNC
}

C --> UC1
C --> UC2
C --> UC3
C --> UC4
C --> UC5
C --> UC6
C --> UC7

UC5 ..> UC_VAL : <<include>>
UC1 ..> UC_SYNC : <<include>>
@enduml